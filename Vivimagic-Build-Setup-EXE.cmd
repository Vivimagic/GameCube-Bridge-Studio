    internal sealed class ThemedFlatButton : Button
    {
        public ThemedFlatButton()
        {
            UseMnemonic = false;
            DoubleBuffered = true;
        }

        protected override void OnPaint(PaintEventArgs pevent)
        {
            if (Enabled)
            {
                base.OnPaint(pevent);
                return;
            }

            Graphics g = pevent.Graphics;
            Color bg = BackColor;
            Color fg = ForeColor;

            // Keep disabled button text crisp and themed (white/light in Dark Mode)
            // instead of letting WinForms fall back to dark SystemColors.GrayText.
            Color disabledFg = Color.FromArgb(
                (fg.R * 82 + bg.R * 18) / 100,
                (fg.G * 82 + bg.G * 18) / 100,
                (fg.B * 82 + bg.B * 18) / 100
            );

            using (SolidBrush bgBrush = new SolidBrush(bg))
            {
                g.FillRectangle(bgBrush, ClientRectangle);
            }

            int borderSize = FlatAppearance.BorderSize;
            if (FlatStyle == FlatStyle.Flat && borderSize > 0)
            {
                Color rawBorder = FlatAppearance.BorderColor.IsEmpty
                    ? ControlPaint.Dark(bg)
                    : FlatAppearance.BorderColor;
                Color disabledBorder = Color.FromArgb(
                    (rawBorder.R * 72 + bg.R * 28) / 100,
                    (rawBorder.G * 72 + bg.G * 28) / 100,
                    (rawBorder.B * 72 + bg.B * 28) / 100
                );
                using (Pen borderPen = new Pen(disabledBorder, borderSize))
                {
                    int inset = borderSize / 2;
                    g.DrawRectangle(
                        borderPen,
                        inset,
                        inset,
                        Math.Max(0, Width - borderSize),
                        Math.Max(0, Height - borderSize)
                    );
                }
            }

            TextFormatFlags flags =
                TextFormatFlags.SingleLine |
                TextFormatFlags.HorizontalCenter |
                TextFormatFlags.VerticalCenter |
                TextFormatFlags.EndEllipsis |
                TextFormatFlags.NoPrefix;

            if (TextAlign == ContentAlignment.MiddleLeft || TextAlign == ContentAlignment.TopLeft || TextAlign == ContentAlignment.BottomLeft)
            {
                flags = (flags & ~TextFormatFlags.HorizontalCenter) | TextFormatFlags.Left;
            }
            else if (TextAlign == ContentAlignment.MiddleRight || TextAlign == ContentAlignment.TopRight || TextAlign == ContentAlignment.BottomRight)
            {
                flags = (flags & ~TextFormatFlags.HorizontalCenter) | TextFormatFlags.Right;
            }

            Rectangle textRect = new Rectangle(
                Padding.Left + 2,
                Padding.Top + 1,
                Math.Max(0, Width - Padding.Horizontal - 4),
                Math.Max(0, Height - Padding.Vertical - 2)
            );
            TextRenderer.DrawText(g, Text, Font, textRect, disabledFg, flags);
        }
    }

    internal sealed class AnimatedSettingsButton : Control
    {
        private readonly System.Windows.Forms.Timer animTimer;
        private float angleDeg = 0F;
        private float targetAngleDeg = 0F;
        private bool hovered = false;
        private bool activeState = false;
        private Color borderCol = Color.FromArgb(203, 213, 225);
        private Color hoverBgCol = Color.FromArgb(238, 242, 255);
        private Color activeBgCol = Color.FromArgb(79, 70, 229);
        private Color activeFgCol = Color.White;
        private Color gearAccentCol = Color.FromArgb(79, 70, 229);

        public AnimatedSettingsButton()
        {
            SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.UserPaint | ControlStyles.ResizeRedraw, true);
            Cursor = Cursors.Hand;
            AccessibleName = "Settings";
            animTimer = new System.Windows.Forms.Timer();
            animTimer.Interval = 16;
            animTimer.Tick += delegate
            {
                float diff = targetAngleDeg - angleDeg;
                if (Math.Abs(diff) <= 1.2F)
                {
                    angleDeg = targetAngleDeg % 360F;
                    if (angleDeg < 0F) angleDeg += 360F;
                    targetAngleDeg = angleDeg;
                    animTimer.Stop();
                }
                else
                {
                    float step = diff * 0.14F;
                    if (diff > 0F && step < 4.0F) step = Math.Min(diff, 4.0F);
                    if (diff < 0F && step > -4.0F) step = Math.Max(diff, -4.0F);
                    angleDeg += step;
                }
                Invalidate();
            };
        }

        public bool Active
        {
            get { return activeState; }
            set
            {
                activeState = value;
                Invalidate();
            }
        }

        public void SetPalette(Color bg, Color hoverBg, Color fg, Color border, Color activeBg, Color activeFg, Color gearAccent)
        {
            BackColor = bg;
            hoverBgCol = hoverBg;
            ForeColor = fg;
            borderCol = border;
            activeBgCol = activeBg;
            activeFgCol = activeFg;
            gearAccentCol = gearAccent;
            Invalidate();
        }

        protected override void OnMouseEnter(EventArgs e)
        {
            base.OnMouseEnter(e);
            hovered = true;
            // Full 360-degree clockwise rotation on every mouse-over
            targetAngleDeg = angleDeg + 360F;
            if (!animTimer.Enabled) animTimer.Start();
            Invalidate();
        }

        protected override void OnMouseLeave(EventArgs e)
        {
            base.OnMouseLeave(e);
            hovered = false;
            Invalidate();
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            Color bg = activeState ? activeBgCol : (hovered ? hoverBgCol : BackColor);
            Color iconCol = activeState ? activeFgCol : (hovered ? gearAccentCol : ForeColor);

            using (SolidBrush br = new SolidBrush(bg))
            {
                g.FillRectangle(br, ClientRectangle);
            }
            using (Pen bp = new Pen(activeState ? activeBgCol : (hovered ? gearAccentCol : borderCol), 1F))
            {
                g.DrawRectangle(bp, 0, 0, Width - 1, Height - 1);
            }

            // Centered icon-only 8-tooth vector gear with full 360-degree rotation
            float cx = Width / 2F;
            float cy = Height / 2F;
            GraphicsState st = g.Save();
            g.TranslateTransform(cx, cy);
            g.RotateTransform(angleDeg);
            using (Pen gp = new Pen(iconCol, 1.75F))
            {
                gp.StartCap = LineCap.Round;
                gp.EndCap = LineCap.Round;
                for (int i = 0; i < 8; i++)
                {
                    double rad = i * (Math.PI / 4.0);
                    float x1 = (float)(Math.Cos(rad) * 5.2);
                    float y1 = (float)(Math.Sin(rad) * 5.2);
                    float x2 = (float)(Math.Cos(rad) * 8.0);
                    float y2 = (float)(Math.Sin(rad) * 8.0);
                    g.DrawLine(gp, x1, y1, x2, y2);
                }
                g.DrawEllipse(gp, -5.0F, -5.0F, 10.0F, 10.0F);
            }
            using (SolidBrush holeBr = new SolidBrush(bg))
            {
                g.FillEllipse(holeBr, -2.3F, -2.3F, 4.6F, 4.6F);
            }
            using (Pen innerP = new Pen(iconCol, 1.35F))
            {
                g.DrawEllipse(innerP, -2.3F, -2.3F, 4.6F, 4.6F);
            }
            g.Restore(st);
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing && animTimer != null)
            {
                animTimer.Stop();
                animTimer.Dispose();
            }
            base.Dispose(disposing);
        }
    }

    internal sealed class AnimatedThemeButton : Control
    {
        private readonly bool isDarkOption;
        private readonly System.Windows.Forms.Timer animTimer;
        private float hoverAnim = 0F;
        private float targetHover = 0F;
        private float sunSpinDeg = 0F;
        private bool hovered = false;
        private bool selectedState = false;
        private bool parentIsDark = false;

        public AnimatedThemeButton(bool darkOption)
        {
            isDarkOption = darkOption;
            SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.UserPaint | ControlStyles.ResizeRedraw, true);
            Cursor = Cursors.Hand;
            Font = new Font("Segoe UI", 8.5F, FontStyle.Bold);
            Text = darkOption ? "Dark Mode" : "Light Mode";
            animTimer = new System.Windows.Forms.Timer();
            animTimer.Interval = 16;
            animTimer.Tick += delegate
            {
                bool keepRunning = false;
                float diff = targetHover - hoverAnim;
                if (Math.Abs(diff) <= 0.02F)
                {
                    hoverAnim = targetHover;
                }
                else
                {
                    hoverAnim += diff * 0.22F;
                    keepRunning = true;
                }

                if (!isDarkOption && hovered)
                {
                    sunSpinDeg = (sunSpinDeg + 3.2F) % 360F;
                    keepRunning = true;
                }
                else if (!isDarkOption && sunSpinDeg > 0.5F && sunSpinDeg < 359.5F)
                {
                    float rem = 90F - (sunSpinDeg % 90F);
                    if (rem < 2.5F)
                    {
                        sunSpinDeg = 0F;
                    }
                    else
                    {
                        sunSpinDeg = (sunSpinDeg + Math.Min(rem, 4.5F)) % 360F;
                        keepRunning = true;
                    }
                }

                if (!keepRunning)
                {
                    animTimer.Stop();
                }
                Invalidate();
            };
        }

        public void SetThemeState(bool isSelected, bool darkThemeActive)
        {
            selectedState = isSelected;
            parentIsDark = darkThemeActive;
            Invalidate();
        }

        protected override void OnMouseEnter(EventArgs e)
        {
            base.OnMouseEnter(e);
            hovered = true;
            targetHover = 1F;
            if (!animTimer.Enabled) animTimer.Start();
            Invalidate();
        }

        protected override void OnMouseLeave(EventArgs e)
        {
            base.OnMouseLeave(e);
            hovered = false;
            targetHover = 0F;
            if (!animTimer.Enabled) animTimer.Start();
            Invalidate();
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;

            Color bg;
            Color border;
            Color fg;
            Color iconCol;

            if (!isDarkOption)
            {
                if (selectedState)
                {
                    bg = Color.FromArgb(254, 243, 199);
                    border = Color.FromArgb(245, 158, 11);
                    fg = Color.FromArgb(120, 53, 15);
                    iconCol = Color.FromArgb(217, 119, 6);
                }
                else if (parentIsDark)
                {
                    bg = hovered ? Color.FromArgb(51, 65, 85) : Color.FromArgb(15, 23, 42);
                    border = hovered ? Color.FromArgb(245, 158, 11) : Color.FromArgb(71, 85, 105);
                    fg = Color.FromArgb(226, 232, 240);
                    iconCol = hovered ? Color.FromArgb(251, 191, 36) : Color.FromArgb(148, 163, 184);
                }
                else
                {
                    bg = hovered ? Color.FromArgb(255, 251, 235) : Color.FromArgb(248, 250, 252);
                    border = hovered ? Color.FromArgb(245, 158, 11) : Color.FromArgb(203, 213, 225);
                    fg = Color.FromArgb(51, 65, 85);
                    iconCol = hovered ? Color.FromArgb(217, 119, 6) : Color.FromArgb(100, 116, 139);
                }
            }
            else
            {
                if (selectedState)
                {
                    bg = Color.FromArgb(49, 46, 129);
                    border = Color.FromArgb(129, 140, 248);
                    fg = Color.FromArgb(238, 242, 255);
                    iconCol = Color.FromArgb(165, 180, 252);
                }
                else if (parentIsDark)
                {
                    bg = hovered ? Color.FromArgb(51, 65, 85) : Color.FromArgb(15, 23, 42);
                    border = hovered ? Color.FromArgb(129, 140, 248) : Color.FromArgb(71, 85, 105);
                    fg = Color.FromArgb(226, 232, 240);
                    iconCol = hovered ? Color.FromArgb(165, 180, 252) : Color.FromArgb(148, 163, 184);
                }
                else
                {
                    bg = hovered ? Color.FromArgb(238, 242, 255) : Color.FromArgb(248, 250, 252);
                    border = hovered ? Color.FromArgb(99, 102, 241) : Color.FromArgb(203, 213, 225);
                    fg = Color.FromArgb(51, 65, 85);
                    iconCol = hovered ? Color.FromArgb(79, 70, 229) : Color.FromArgb(100, 116, 139);
                }
            }

            using (SolidBrush br = new SolidBrush(bg))
            {
                g.FillRectangle(br, ClientRectangle);
            }
            using (Pen bp = new Pen(border, selectedState ? 1.5F : 1F))
            {
                g.DrawRectangle(bp, 0, 0, Width - 1, Height - 1);
            }

            // Center icon + label pair horizontally
            Size textSz = TextRenderer.MeasureText(Text, Font);
            int totalW = 20 + 7 + textSz.Width;
            float iconCx = (Width - totalW) / 2F + 10F;
            float iconCy = Height / 2F;

            if (!isDarkOption)
            {
                // Animated rotating vector Sun icon
                GraphicsState st = g.Save();
                g.TranslateTransform(iconCx, iconCy);
                g.RotateTransform(sunSpinDeg);
                float rayOuter = 7.4F + hoverAnim * 1.1F;
                float coreR = 3.4F + hoverAnim * 0.35F;
                using (Pen sp = new Pen(iconCol, 1.65F))
                {
                    sp.StartCap = LineCap.Round;
                    sp.EndCap = LineCap.Round;
                    for (int i = 0; i < 8; i++)
                    {
                        double rad = i * (Math.PI / 4.0);
                        float x1 = (float)(Math.Cos(rad) * 5.2);
                        float y1 = (float)(Math.Sin(rad) * 5.2);
                        float x2 = (float)(Math.Cos(rad) * rayOuter);
                        float y2 = (float)(Math.Sin(rad) * rayOuter);
                        g.DrawLine(sp, x1, y1, x2, y2);
                    }
                    g.DrawEllipse(sp, -coreR, -coreR, coreR * 2F, coreR * 2F);
                }
                g.Restore(st);
            }
            else
            {
                // Animated tilting vector Crescent Moon + twinkling stars icon
                GraphicsState st = g.Save();
                g.TranslateTransform(iconCx, iconCy);
                g.RotateTransform(-14F * hoverAnim);
                using (SolidBrush moonBr = new SolidBrush(iconCol))
                {
                    g.FillEllipse(moonBr, -6.6F, -6.6F, 13.2F, 13.2F);
                }
                using (SolidBrush cutBr = new SolidBrush(bg))
                {
                    g.FillEllipse(cutBr, -2.6F, -8.2F, 11.4F, 11.4F);
                }
                // Two subtle 4-point twinkling stars
                float s1 = 1.7F + hoverAnim * 0.9F;
                float s2 = 1.1F + hoverAnim * 0.7F;
                using (Pen starP = new Pen(iconCol, 1.25F))
                {
                    starP.StartCap = LineCap.Round;
                    starP.EndCap = LineCap.Round;
                    g.DrawLine(starP, 4.4F - s1, -4.6F, 4.4F + s1, -4.6F);
                    g.DrawLine(starP, 4.4F, -4.6F - s1, 4.4F, -4.6F + s1);

                    g.DrawLine(starP, 6.8F - s2, -0.4F, 6.8F + s2, -0.4F);
                    g.DrawLine(starP, 6.8F, -0.4F - s2, 6.8F, -0.4F + s2);
                }
                g.Restore(st);
            }

            Rectangle textRect = new Rectangle((int)(iconCx + 13F), 0, textSz.Width + 6, Height);
            TextRenderer.DrawText(g, Text, Font, textRect, fg, TextFormatFlags.VerticalCenter | TextFormatFlags.Left | TextFormatFlags.NoPadding);
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing && animTimer != null)
            {
                animTimer.Stop();
                animTimer.Dispose();
            }
            base.Dispose(disposing);
        }
    }

