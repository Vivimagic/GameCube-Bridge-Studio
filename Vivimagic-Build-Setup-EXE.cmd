@echo off
setlocal
title Vivimagic - Build Signed Native GUI Installer EXE

:: Auto-elevate to Administrator (required for Authenticode local publisher trust; skipped in headless CI)
if not "%VIVIMAGIC_CI%"=="1" (
  net session >nul 2>&1
  if %errorLevel% neq 0 (
    powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
  )
)

:: Extract embedded PowerShell builder to a temp file and compile the GUI .exe silently
powershell -NoProfile -ExecutionPolicy Bypass -Command "$m = '#__' + 'PS_BUILDER__'; $c = Get-Content -LiteralPath '%~f0' -Raw -Encoding UTF8; $idx = $c.LastIndexOf($m); if ($idx -lt 0) { exit 1 }; $tmp = Join-Path $env:TEMP 'Vivimagic_Build_Setup_EXE.ps1'; Set-Content -Path $tmp -Value $c.Substring($idx) -Encoding UTF8"
if exist "%TEMP%\Vivimagic_Build_Setup_EXE.ps1" (
  powershell -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\Vivimagic_Build_Setup_EXE.ps1" -OutputDir "%~dp0."
  set "BUILD_EC=%ERRORLEVEL%"
  del /f /q "%TEMP%\Vivimagic_Build_Setup_EXE.ps1" >nul 2>&1
  exit /b %BUILD_EC%
) else (
  echo [ERROR] Failed to extract Vivimagic GUI EXE Builder payload.
  if not "%VIVIMAGIC_CI%"=="1" pause
  exit /b 1
)

#__PS_BUILDER__
param(
  [string]$OutputDir = "."
)

$ErrorActionPreference = "Stop"
$ResolvedOutDir = [System.IO.Path]::GetFullPath($OutputDir)
$OutExePath = Join-Path $ResolvedOutDir "Vivimagic-MayflashW012-Setup.exe"
$WorkDir = Join-Path $env:TEMP ("Vivimagic_Build_" + [Guid]::NewGuid().ToString("N"))
New-Item -ItemType Directory -Force -Path $WorkDir | Out-Null

try {
  $cscCandidates = @(
    "C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe",
    "C:\Windows\Microsoft.NET\Framework\v4.0.30319\csc.exe"
  )
  $cscExe = $cscCandidates | Where-Object { Test-Path $_ } | Select-Object -First 1
  if (-not $cscExe) {
    throw "Microsoft .NET Framework 4.x csc.exe was not found on this machine."
  }

  $setupPs1Path = Join-Path $WorkDir "setup.ps1"
  $svgPath      = Join-Path $WorkDir "vivimagic-w012-installer.svg"
  $icoPath      = Join-Path $WorkDir "vivimagic-w012-installer.ico"
  $pngPath      = Join-Path $WorkDir "vivimagic-w012-installer.png"
  $manifestPath = Join-Path $WorkDir "app.manifest"
  $programCs    = Join-Path $WorkDir "Program.cs"

  [System.IO.File]::WriteAllBytes($setupPs1Path, [System.Convert]::FromBase64String(""))
  [System.IO.File]::WriteAllBytes($svgPath,      [System.Convert]::FromBase64String(""))

  $icoB64 = ""
  if ($icoB64.Length -gt 64) {
    [System.IO.File]::WriteAllBytes($icoPath, [System.Convert]::FromBase64String($icoB64))
  } else {
    Add-Type -AssemblyName System.Drawing
    $bmp = New-Object System.Drawing.Bitmap(64, 64)
    $g = [System.Drawing.Graphics]::FromImage($bmp)
    $g.Clear([System.Drawing.Color]::FromArgb(255, 79, 70, 229))
    $ms = New-Object System.IO.MemoryStream
    $bmp.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png)
    $pngBytes = $ms.ToArray()
    $fs = [System.IO.File]::Create($icoPath)
    $bw = New-Object System.IO.BinaryWriter($fs)
    $bw.Write([UInt16]0); $bw.Write([UInt16]1); $bw.Write([UInt16]1)
    $bw.Write([Byte]64); $bw.Write([Byte]64); $bw.Write([Byte]0); $bw.Write([Byte]0)
    $bw.Write([UInt16]1); $bw.Write([UInt16]32)
    $bw.Write([UInt32]$pngBytes.Length); $bw.Write([UInt32]22)
    $bw.Write($pngBytes)
    $bw.Close(); $fs.Close(); $ms.Dispose(); $g.Dispose(); $bmp.Dispose()
  }

  $pngB64 = ""
  if ($pngB64.Length -gt 64) {
    [System.IO.File]::WriteAllBytes($pngPath, [System.Convert]::FromBase64String($pngB64))
  } else {
    [System.IO.File]::WriteAllBytes($pngPath, [System.Convert]::FromBase64String("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="))
  }

  @'
