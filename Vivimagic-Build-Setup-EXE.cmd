        private static bool DetectSystemDarkMode()
        {
            try
            {
                using (RegistryKey prefKey = Registry.CurrentUser.OpenSubKey(@"Software\Vivimagic\GCBridgeW012"))
                {
                    if (prefKey != null)
                    {
                        object saved = prefKey.GetValue("DarkMode");
                        if (saved is int) return ((int)saved != 0);
                    }
                }
            }
            catch { }
            try
            {
                using (RegistryKey key = Registry.CurrentUser.OpenSubKey(@"Software\Microsoft\Windows\CurrentVersion\Themes\Personalize"))
                {
                    if (key != null)
                    {
                        object val = key.GetValue("AppsUseLightTheme");
                        if (val is int && (int)val == 0)
                        {
                            return true;
                        }
                    }
                }
            }
            catch { }
            return false;
        }

        private void ApplyTitleBarTheme()
        {
            if (!IsHandleCreated) return;
            try
            {
                int useDark = isDarkMode ? 1 : 0;
                if (DwmSetWindowAttribute(Handle, 20, ref useDark, 4) != 0)
                {
                    DwmSetWindowAttribute(Handle, 19, ref useDark, 4);
                }
            }
            catch { }
        }

