        private static string GetDirectLockPath()
        {
            return Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData),
                "GCBridgeW012",
                "tester_direct.lock"
            );
        }

        private static string GetBridgeStatusPath()
        {
            return Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData),
                "GCBridgeW012",
                "bridge_status.txt"
            );
        }

        private static string ReadBridgeStatus()
        {
            try
            {
                string sp = GetBridgeStatusPath();
                if (File.Exists(sp))
                {
                    return (File.ReadAllText(sp) ?? "").Trim();
                }
            }
            catch { }
            return "";
        }

        private void AcquireDirectLock()
        {
            try
            {
                string lp = GetDirectLockPath();
                string dir = Path.GetDirectoryName(lp);
                if (!string.IsNullOrEmpty(dir) && Directory.Exists(dir))
                {
                    File.WriteAllText(lp, "testing");
                    createdDirectLock = true;
                }
                Process[] delfs = Process.GetProcesses();
                for (int i = 0; i < delfs.Length; i++)
                {
                    try
                    {
                        if (delfs[i].ProcessName.IndexOf("Delfinovin", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            delfs[i].Kill();
                        }
                    }
                    catch { }
                }
            }
            catch { }
        }

        private void ReleaseDirectLock()
        {
            try
            {
                string lp = GetDirectLockPath();
                if (File.Exists(lp))
                {
                    File.Delete(lp);
                }
            }
            catch { }
            createdDirectLock = false;
        }

        private static string FindBlockingEmulatorName()
        {
            string[] emus = new string[] { "Dolphin", "Slippi Dolphin", "DolphinQt2", "DolphinWx" };
            try
            {
                int myPid = Process.GetCurrentProcess().Id;
                Process[] procs = Process.GetProcesses();
                for (int i = 0; i < procs.Length; i++)
                {
                    if (procs[i].Id == myPid) continue;
                    string n = procs[i].ProcessName ?? "";
                    for (int j = 0; j < emus.Length; j++)
                    {
                        if (n.IndexOf(emus[j], StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            return procs[i].ProcessName;
                        }
                    }
                }
            }
            catch { }
            return null;
        }

        private void CloseBlockingEmulatorAsync(string emuName)
        {
            if (closingEmu || string.IsNullOrEmpty(emuName)) return;
            closingEmu = true;
            btnCloseEmu.Enabled = false;
            btnCloseEmu.Text = "Closing...";
            lblPadHint.Text = "Closing " + emuName + " so the Live Tester can resume...";

            Thread t = new Thread(delegate()
            {
                try
                {
                    int myPid = Process.GetCurrentProcess().Id;
                    string[] configured = new string[] { "Dolphin", "Slippi Dolphin", "DolphinQt2", "DolphinWx" };
                    Process[] procs = Process.GetProcesses();
                    List<Process> targets = new List<Process>();
                    for (int i = 0; i < procs.Length; i++)
                    {
                        try
                        {
                            if (procs[i].Id == myPid) continue;
                            string pName = procs[i].ProcessName ?? "";
                            bool match = string.Equals(pName, emuName, StringComparison.OrdinalIgnoreCase) ||
                                         (emuName.Length >= 4 && pName.IndexOf(emuName, StringComparison.OrdinalIgnoreCase) >= 0);
                            if (!match)
                            {
                                for (int j = 0; j < configured.Length; j++)
                                {
                                    if (configured[j].Length >= 4 && pName.IndexOf(configured[j], StringComparison.OrdinalIgnoreCase) >= 0)
                                    {
                                        match = true;
                                        break;
                                    }
                                }
                            }
                            if (match)
                            {
                                targets.Add(procs[i]);
                            }
                        }
                        catch { }
                    }

                    for (int i = 0; i < targets.Count; i++)
                    {
                        try { targets[i].CloseMainWindow(); } catch { }
                    }
                    for (int i = 0; i < targets.Count; i++)
                    {
                        try { targets[i].WaitForExit(1200); } catch { }
                    }
                    for (int i = 0; i < targets.Count; i++)
                    {
                        try
                        {
                            if (!targets[i].HasExited)
                            {
                                targets[i].Kill();
                                targets[i].WaitForExit(1000);
                            }
                        }
                        catch { }
                    }
                }
                catch { }
                finally
                {
                    closingEmu = false;
                    try
                    {
                        if (!IsDisposed && IsHandleCreated)
                        {
                            BeginInvoke((MethodInvoker)delegate
                            {
                                btnCloseEmu.Enabled = true;
                                RefreshTesterUi();
                            });
                        }
                    }
                    catch { }
                }
            });
            t.IsBackground = true;
            t.Start();
        }

        private static bool IsBridgeRunning()
