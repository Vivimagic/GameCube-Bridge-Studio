    internal static class NativeXInput
    {
        private static int provider = 0;

        [DllImport("xinput1_4.dll", EntryPoint = "XInputGetState")]
        private static extern uint GetState14(uint dwUserIndex, out XINPUT_STATE pState);

        [DllImport("xinput1_4.dll", EntryPoint = "XInputSetState")]
        private static extern uint SetState14(uint dwUserIndex, ref XINPUT_VIBRATION pVibration);

        [DllImport("xinput1_3.dll", EntryPoint = "XInputGetState")]
        private static extern uint GetState13(uint dwUserIndex, out XINPUT_STATE pState);

        [DllImport("xinput1_3.dll", EntryPoint = "XInputSetState")]
        private static extern uint SetState13(uint dwUserIndex, ref XINPUT_VIBRATION pVibration);

        [DllImport("xinput9_1_0.dll", EntryPoint = "XInputGetState")]
        private static extern uint GetState910(uint dwUserIndex, out XINPUT_STATE pState);

        [DllImport("xinput9_1_0.dll", EntryPoint = "XInputSetState")]
        private static extern uint SetState910(uint dwUserIndex, ref XINPUT_VIBRATION pVibration);

        public static uint GetState(uint userIndex, out XINPUT_STATE state)
        {
            state = new XINPUT_STATE();
            if (provider == 0 || provider == 1)
            {
                try
                {
                    uint r = GetState14(userIndex, out state);
                    provider = 1;
                    return r;
                }
                catch (DllNotFoundException) { provider = 2; }
                catch (EntryPointNotFoundException) { provider = 2; }
            }
            if (provider == 2)
            {
                try
                {
                    uint r = GetState13(userIndex, out state);
                    return r;
                }
                catch (DllNotFoundException) { provider = 3; }
                catch (EntryPointNotFoundException) { provider = 3; }
            }
            try
            {
                return GetState910(userIndex, out state);
            }
            catch
            {
                return 1167;
            }
        }

        public static uint SetState(uint userIndex, ushort leftMotor, ushort rightMotor)
        {
            XINPUT_VIBRATION vib = new XINPUT_VIBRATION();
            vib.wLeftMotorSpeed = leftMotor;
            vib.wRightMotorSpeed = rightMotor;
            if (provider == 0 || provider == 1)
            {
                try
                {
                    uint r = SetState14(userIndex, ref vib);
                    provider = 1;
                    return r;
                }
                catch (DllNotFoundException) { provider = 2; }
                catch (EntryPointNotFoundException) { provider = 2; }
            }
            if (provider == 2)
            {
                try
                {
                    return SetState13(userIndex, ref vib);
                }
                catch (DllNotFoundException) { provider = 3; }
                catch (EntryPointNotFoundException) { provider = 3; }
            }
            try
            {
                return SetState910(userIndex, ref vib);
            }
            catch
            {
                return 1167;
            }
        }
    }

