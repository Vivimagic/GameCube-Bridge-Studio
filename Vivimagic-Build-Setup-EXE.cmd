        private static string EscapeCString(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "").Replace("\n", " ");
        }

        private string BuildOpenGcHeader()
        {
            string nl = Environment.NewLine;
            string fwName = EscapeCString(txtFwName.Text.Trim());
            string fwAuthor = EscapeCString(txtFwAuthor.Text.Trim());
            string fwVer = EscapeCString(txtFwVersion.Text.Trim());
            int pollHz = GetSelectedPollHz();
            int bInterval = Math.Max(1, (int)Math.Round(1000.0 / pollHz));
            int pwmHz = GetSelectedPwmHz();
            int snapMs = (int)numFwSnapback.Value;
            bool dualMode = (cmbFwPersonality.SelectedIndex == 1);
            bool startZ = (cmbFwRecovery.SelectedIndex == 0);
            string targetDesc = cmbFwTarget.SelectedIndex == 1
                ? "RP2040 Direct 4-Port JoyBus Replacement PCB"
                : "RP2040 Inline USB-Host Bridge (Leaves Mayflash W012 100% Stock OG)";

            StringBuilder sb = new StringBuilder();
            sb.Append("/*").Append(nl);
            sb.Append(" * opengc_config.h - Generated by Vivimagic Firmware & SDK Lab").Append(nl);
            sb.Append(" * Firmware Name : ").Append(fwName).Append(" (v").Append(fwVer).Append(")").Append(nl);
            sb.Append(" * Publisher     : Vivimagic").Append(nl);
            sb.Append(" * Author        : ").Append(fwAuthor).Append(nl);
            sb.Append(" * Target Board  : ").Append(targetDesc).Append(nl);
            sb.Append(" * Reversible    : Hold [").Append(GetFwRecoveryKey().ToUpperInvariant()).Append("] on plug-in for RP2040 UF2 bootloader.").Append(nl);
            sb.Append(" */").Append(nl).Append(nl);
            sb.Append("#pragma once").Append(nl);
            sb.Append("#include <stdint.h>").Append(nl);
            sb.Append("#include <stdbool.h>").Append(nl).Append(nl);
            sb.Append("#define OPENGC_FW_NAME                \"").Append(fwName).Append("\"").Append(nl);
            sb.Append("#define OPENGC_FW_PUBLISHER           \"Vivimagic\"").Append(nl);
            sb.Append("#define OPENGC_FW_AUTHOR              \"").Append(fwAuthor).Append("\"").Append(nl);
            sb.Append("#define OPENGC_FW_VERSION             \"").Append(fwVer).Append("\"").Append(nl).Append(nl);
            sb.Append("/* USB Device Personality & Polling Rate */").Append(nl);
            sb.Append("#define OPENGC_USB_POLL_HZ            ").Append(pollHz).Append("u").Append(nl);
            sb.Append("#define OPENGC_USB_BINTERVAL_MS       ").Append(bInterval).Append("u").Append(nl);
            sb.Append("#define OPENGC_DUAL_MODE_ENABLED      ").Append(dualMode ? "1" : "0").Append(nl);
            sb.Append("#define OPENGC_HARDWARE_LED_STATUS    ").Append(chkFwLed.Checked ? "1" : "0").Append(nl).Append(nl);
            sb.Append("/* Safe Unbrickable UF2 Bootloader Combo */").Append(nl);
            sb.Append("#define OPENGC_RECOVERY_COMBO_START_Z ").Append(startZ ? "1" : "0").Append(nl);
            sb.Append("#define OPENGC_RECOVERY_COMBO_L_R_ST  ").Append(startZ ? "0" : "1").Append(nl).Append(nl);
            sb.Append("/* Input Mapping & Calibration (Baked from GCBridge Studio) */").Append(nl);
            sb.Append("#define OPENGC_FACE_XBOX_SPATIAL      0").Append(nl);
            sb.Append("#define OPENGC_FACE_NINTENDO_LABELS   1").Append(nl);
            sb.Append("#define OPENGC_FACE_PLATFORMER        2").Append(nl);
            sb.Append("#define OPENGC_FACE_LAYOUT            OPENGC_FACE_XBOX_SPATIAL").Append(nl);
            sb.Append("#define OPENGC_NINTENDO_BUTTON_LAYOUT 0").Append(nl);
            sb.Append("#define OPENGC_Z_TARGET               \"RB\"").Append(nl);
            sb.Append("#define OPENGC_START_UP_IS_BACK       1").Append(nl);
            sb.Append("#define OPENGC_TRIGGERS_AS_BUMPERS    0").Append(nl);
            sb.Append("#define OPENGC_MAIN_DEADZONE_F        0.100f").Append(nl);
            sb.Append("#define OPENGC_MAIN_RANGE_SCALE_F     1.12f").Append(nl);
            sb.Append("#define OPENGC_CSTICK_DEADZONE_F      0.120f").Append(nl);
            sb.Append("#define OPENGC_CSTICK_RANGE_SCALE_F   1.15f").Append(nl);
            sb.Append("#define OPENGC_SNAPBACK_FILTER_MS     ").Append(snapMs).Append("u").Append(nl);
            sb.Append("#define OPENGC_TRIGGER_THRESHOLD_U8   175u").Append(nl).Append(nl);
            sb.Append("/* Hardware PWM Rumble Motor Shaping */").Append(nl);
            sb.Append("#define OPENGC_RUMBLE_ENABLED         1").Append(nl);
            sb.Append("#define OPENGC_RUMBLE_MIN_BYTE        31u").Append(nl);
            sb.Append("#define OPENGC_RUMBLE_SCALE_PCT       100u").Append(nl);
            sb.Append("#define OPENGC_RUMBLE_PWM_HZ          ").Append(pwmHz).Append("u").Append(nl);
            return sb.ToString();
        }

        private string BuildOpenGcSourceC()
        {
            string nl = Environment.NewLine;
            int pwmHz = GetSelectedPwmHz();
            string modeDesc = cmbFwTarget.SelectedIndex == 1
                ? "Direct 4-Port GameCube JoyBus Hardware Controller"
                : "Zero-Solder Reversible Inline USB Bridge for Stock Mayflash W012";
            StringBuilder sb = new StringBuilder();
            sb.Append("/*").Append(nl);
            sb.Append(" * opengc_xinput_firmware.c - Open-Source Reversible XInput + Rumble Firmware").Append(nl);
            sb.Append(" * Target : Raspberry Pi Pico / RP2040 (Pico SDK + TinyUSB + Pico-PIO-USB)").Append(nl);
            sb.Append(" * Mode   : ").Append(modeDesc).Append(nl);
            sb.Append(" * Revert : Hold ").Append(GetFwRecoveryKey().ToUpperInvariant()).Append(" on plug-in to mount RPI-RP2 UF2 drive.").Append(nl);
            sb.Append(" */").Append(nl).Append(nl);
            sb.Append("#include \"opengc_config.h\"").Append(nl);
            sb.Append("#include \"pico/stdlib.h\"").Append(nl);
            sb.Append("#include \"pico/bootrom.h\"").Append(nl);
            sb.Append("#include \"tusb.h\"").Append(nl);
            sb.Append("#include <math.h>").Append(nl);
            sb.Append("#include <string.h>").Append(nl).Append(nl);
            sb.Append("#define WUP028_VID          0x057E").Append(nl);
            sb.Append("#define WUP028_PID          0x0337").Append(nl);
            sb.Append("#define WUP028_CMD_INIT     0x13").Append(nl);
            sb.Append("#define WUP028_CMD_RUMBLE   0x11").Append(nl);
            sb.Append("#define WUP028_REPORT_ID_IN 0x21").Append(nl).Append(nl);
            sb.Append("typedef struct { uint8_t status, btn1, btn2, stick_x, stick_y, c_x, c_y, trig_l, trig_r; } gc_raw_port_t;").Append(nl);
            sb.Append("typedef struct __attribute__((packed)) {").Append(nl);
            sb.Append("    uint8_t report_id, report_size; uint16_t buttons; uint8_t lt, rt;").Append(nl);
            sb.Append("    int16_t lx, ly, rx, ry; uint8_t reserved[6];").Append(nl);
            sb.Append("} xinput_in_report_t;").Append(nl).Append(nl);
            sb.Append("static volatile uint8_t g_xinput_rumble_target[4] = {0, 0, 0, 0};").Append(nl);
            sb.Append("static uint8_t g_last_wup_rumble_pkt[5] = {WUP028_CMD_RUMBLE, 0, 0, 0, 0};").Append(nl).Append(nl);
            sb.Append("static void check_safe_uf2_recovery(const gc_raw_port_t *p0) {").Append(nl);
            sb.Append("    bool start = (p0->btn2 & 0x01) != 0, z = (p0->btn2 & 0x02) != 0;").Append(nl);
            sb.Append("    bool r_dig = (p0->btn2 & 0x04) != 0, l_dig = (p0->btn2 & 0x08) != 0;").Append(nl);
            sb.Append("#if OPENGC_RECOVERY_COMBO_START_Z").Append(nl);
            sb.Append("    if (start && z) reset_usb_boot(0, 0);").Append(nl);
            sb.Append("#elif OPENGC_RECOVERY_COMBO_L_R_ST").Append(nl);
            sb.Append("    if (l_dig && r_dig && start) reset_usb_boot(0, 0);").Append(nl);
            sb.Append("#endif").Append(nl);
            sb.Append("}").Append(nl).Append(nl);
            sb.Append("/* Hardware PWM task running at ").Append(pwmHz).Append(" Hz (OPENGC_RUMBLE_PWM_HZ) */").Append(nl);
            sb.Append("void opengc_rumble_pwm_tick(uint8_t dev_addr, uint8_t instance, uint32_t pwm_slot) {").Append(nl);
            sb.Append("    uint8_t pkt[5] = {WUP028_CMD_RUMBLE, 0, 0, 0, 0};").Append(nl);
            sb.Append("    for (int i = 0; i < 4; i++) {").Append(nl);
            sb.Append("        uint8_t target = g_xinput_rumble_target[i];").Append(nl);
            sb.Append("        if (target == 0) pkt[i + 1] = 0;").Append(nl);
            sb.Append("        else if (target >= 235) pkt[i + 1] = 1;").Append(nl);
            sb.Append("        else { uint32_t on = ((uint32_t)target * 8u + 127u) / 255u; pkt[i + 1] = ((pwm_slot % 8u) < (on < 1u ? 1u : on)) ? 1u : 0u; }").Append(nl);
            sb.Append("    }").Append(nl);
            sb.Append("    if (memcmp(pkt, g_last_wup_rumble_pkt, sizeof(pkt)) != 0) {").Append(nl);
            sb.Append("        memcpy(g_last_wup_rumble_pkt, pkt, sizeof(pkt));").Append(nl);
            sb.Append("        tuh_hid_send_report(dev_addr, instance, 0, pkt, sizeof(pkt));").Append(nl);
            sb.Append("    }").Append(nl);
            sb.Append("}").Append(nl);
            return sb.ToString();
        }

