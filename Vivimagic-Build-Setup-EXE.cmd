        private int GetSelectedPollHz()
        {
            int[] rates = new int[] { 125, 250, 500, 1000 };
            int idx = cmbFwPollHz.SelectedIndex;
            return (idx >= 0 && idx < rates.Length) ? rates[idx] : 1000;
        }

        private int GetSelectedPwmHz()
        {
            int[] pwms = new int[] { 60, 120, 200 };
            int idx = cmbFwPwmHz.SelectedIndex;
            return (idx >= 0 && idx < pwms.Length) ? pwms[idx] : 120;
        }

