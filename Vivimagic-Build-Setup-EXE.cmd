        }

        private static void ExtractResource(Assembly asm, string resName, string destPath)
        {
            using (Stream s = asm.GetManifestResourceStream(resName))
            {
                if (s == null) throw new InvalidOperationException("Missing embedded resource: " + resName);
                using (FileStream fs = File.Create(destPath))
                {
                    s.CopyTo(fs);
                }
            }
        }

        private void AppendLog(string line)
        {
            if (IsDisposed) return;
            BeginInvoke((MethodInvoker)delegate
            {
                txtLog.AppendText(line + Environment.NewLine);
            });
        }

        private void UpdateProgress(int pct, string text)
        {
            if (IsDisposed) return;
            BeginInvoke((MethodInvoker)delegate
            {
                int clamped = pct < 0 ? 0 : (pct > 100 ? 100 : pct);
                progressBar.Value = clamped;
                lblStep.Text = text;
                if (isBusy)
                {
                    currentStatusDesc = text;
                    lblStatusDesc.Text = text;
                }
            });
        }

        private void RunAction(string action)
        {
            if (isBusy) return;
            isBusy = true;
            if (testerVisible)
            {
                SetTesterVisible(false);
            }
            if (firmwareVisible)
            {
                SetFirmwareVisible(false);
            }
            btnPrimary.Enabled = false;
            btnUninstall.Enabled = false;
            btnClose.Enabled = false;
            btnTester.Enabled = false;
            btnFirmware.Enabled = false;
            txtLog.Clear();

            string workTitle = action == "uninstall"
                ? "Uninstalling Vivimagic Driver..."
                : (action == "reinstall" ? "Reinstalling with Fresh Settings..." : "Installing Vivimagic Driver...");
            SetStatusBox("working", workTitle, "Preparing setup engine...");
            UpdateProgress(5, "Starting " + action + "...");

            Thread worker = new Thread(delegate()
            {
                string tempDir = Path.Combine(Path.GetTempPath(), "Vivimagic_W012_" + Guid.NewGuid().ToString("N"));
                int exitCode = -1;
                string errMsg = "";
                string finalKind = "";
                string finalTitle = "";
                string finalDesc = "";

                try
                {
                    Directory.CreateDirectory(tempDir);
                    Assembly asm = Assembly.GetExecutingAssembly();
                    string ps1Path = Path.Combine(tempDir, "setup.ps1");
                    string icoPath = Path.Combine(tempDir, "vivimagic-w012-installer.ico");
                    string svgPath = Path.Combine(tempDir, "vivimagic-w012-installer.svg");

                    ExtractResource(asm, "Vivimagic.setup.ps1", ps1Path);
                    ExtractResource(asm, "Vivimagic.installer.ico", icoPath);
                    ExtractResource(asm, "Vivimagic.installer.svg", svgPath);

                    char q = '"';
                    string psArgs =
                        "-NoProfile -ExecutionPolicy Bypass -File " + q + ps1Path + q +
                        " -SourceSetupPath " + q + asm.Location + q +
                        " -IconSourcePath " + q + icoPath + q +
                        " -SvgSourcePath " + q + svgPath + q +
                        " -Action " + q + action + q +
                        " -GuiMode";

                    ProcessStartInfo psi = new ProcessStartInfo("powershell.exe", psArgs);
                    psi.UseShellExecute = false;
                    psi.CreateNoWindow = true;
                    psi.RedirectStandardOutput = true;
                    psi.RedirectStandardError = true;

                    using (Process proc = new Process())
                    {
                        proc.StartInfo = psi;
                        proc.OutputDataReceived += delegate(object sender, DataReceivedEventArgs e)
                        {
                            if (string.IsNullOrEmpty(e.Data)) return;
                            if (e.Data.StartsWith("@@PROGRESS:"))
                            {
                                string payload = e.Data.Substring(11);
                                int sep = payload.IndexOf('|');
                                if (sep > 0)
                                {
                                    int pct;
                                    if (int.TryParse(payload.Substring(0, sep), out pct))
                                    {
                                        UpdateProgress(pct, payload.Substring(sep + 1));
                                    }
                                }
                            }
                            else if (e.Data.StartsWith("@@STATUS:"))
                            {
                                string payload = e.Data.Substring(9);
                                string[] parts = payload.Split(new char[] { '|' }, 3);
                                if (parts.Length == 3)
                                {
                                    finalKind = parts[0];
                                    finalTitle = parts[1];
                                    finalDesc = parts[2];
                                }
                            }
                            else
                            {
                                AppendLog(e.Data);
                            }
                        };
                        proc.ErrorDataReceived += delegate(object sender, DataReceivedEventArgs e)
                        {
                            if (!string.IsNullOrEmpty(e.Data))
                            {
                                AppendLog("[STDERR] " + e.Data);
                            }
                        };
                        proc.Start();
                        proc.BeginOutputReadLine();
                        proc.BeginErrorReadLine();
                        proc.WaitForExit();
                        exitCode = proc.ExitCode;
                    }
                }
                catch (Exception ex)
                {
                    errMsg = ex.Message;
                    AppendLog("[ERROR] " + ex.Message);
                }
                finally
                {
                    try { Directory.Delete(tempDir, true); } catch { }
                }

                if (!IsDisposed)
                {
                    BeginInvoke((MethodInvoker)delegate
                    {
                        isBusy = false;
                        btnPrimary.Enabled = true;
                        btnUninstall.Enabled = true;
                        btnClose.Enabled = true;
                        btnTester.Enabled = true;
                        btnFirmware.Enabled = true;
                        RefreshInstallState(false);

                        if (exitCode == 0 && string.IsNullOrEmpty(errMsg))
                        {
                            if (!string.IsNullOrEmpty(finalTitle))
                            {
                                SetStatusBox(finalKind, finalTitle, finalDesc);
                            }
                            else if (action == "uninstall")
                            {
                                SetStatusBox(
                                    "success",
                                    "Uninstall Complete",
                                    "Vivimagic Mayflash W012 Driver, background handover service, and 057E:0337 WinUSB binding have been completely removed."
                                );
                            }
                            else
                            {
                                SetStatusBox(
                                    "success",
                                    action == "reinstall" ? "Reinstalled with Fresh Settings" : "Installation Complete",
                                    "Native 4-port XInput + Rumble is active for Steam & non-Steam PC games, and Dolphin / Slippi auto-handover is running."
                                );
                            }

                            if (action != "uninstall")
                            {
                                btnTester.Visible = true;
                                SetTesterVisible(true);
                            }
                        }
                        else
                        {
                            if (!detailsVisible) ToggleDetails();
                            string summary = string.IsNullOrEmpty(errMsg)
                                ? "Setup returned exit code " + exitCode + ". Review the details log below."
                                : errMsg;
                            SetStatusBox("error", "Setup Encountered an Error", summary);
                        }
                    });
                }
            });
            worker.IsBackground = true;
            worker.Start();
        }
    }

    internal static class Program
    {
        [STAThread]
        private static void Main(string[] args)
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            bool uninstallRequested = false;
            if (args != null)
            {
                for (int i = 0; i < args.Length; i++)
                {
                    string a = (args[i] ?? "").ToLowerInvariant();
                    if (a == "/uninstall" || a == "-uninstall" || a == "uninstall")
                    {
                        uninstallRequested = true;
                    }
                }
            }
            Application.Run(new SetupForm(uninstallRequested));
        }
    }
}
'@ | Set-Content -Path $programCs -Encoding UTF8

  # Compile pure WinForms GUI executable (/target:winexe -> NO terminal window!)
  if (Test-Path $OutExePath) { Remove-Item -Force $OutExePath }
  $cscArgs = @(
    "/nologo",
    "/optimize+",
    "/target:winexe",
    "/r:System.Windows.Forms.dll",
    "/r:System.Drawing.dll",
    "/out:$OutExePath",
    "/win32icon:vivimagic-w012-installer.ico",
    "/win32manifest:app.manifest",
    "/resource:setup.ps1,Vivimagic.setup.ps1",
    "/resource:vivimagic-w012-installer.ico,Vivimagic.installer.ico",
    "/resource:vivimagic-w012-installer.svg,Vivimagic.installer.svg",
    "/resource:vivimagic-w012-installer.png,Vivimagic.installer.png",
    "Program.cs"
  )
  Push-Location $WorkDir
  try {
    & $cscExe @cscArgs
  } finally {
    Pop-Location
  }
  if (-not (Test-Path $OutExePath)) {
    throw "csc.exe failed to produce $OutExePath."
  }

  # Authenticode-sign the GUI executable as Publisher: Vivimagic
  $isCi = ($env:VIVIMAGIC_CI -eq "1")
  $commercialPfx = Join-Path $ResolvedOutDir "Vivimagic.pfx"
  if (Test-Path $commercialPfx) {
    if ($isCi -and $env:VIVIMAGIC_PFX_PASSWORD) {
      $pfxPass = ConvertTo-SecureString -String $env:VIVIMAGIC_PFX_PASSWORD -AsPlainText -Force
    } else {
      $pfxPass = Read-Host "Enter password for Vivimagic.pfx" -AsSecureString
    }
    $signingCert = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2($commercialPfx, $pfxPass)
    Set-AuthenticodeSignature -FilePath $OutExePath -Certificate $signingCert -HashAlgorithm SHA256 -TimestampServer "http://timestamp.digicert.com" | Out-Null
    Write-Host "[OK] Authenticode-signed $OutExePath using Vivimagic.pfx"
  } elseif (-not $isCi) {
    $signingCert = Get-ChildItem -Path "Cert:\LocalMachine\My" -ErrorAction SilentlyContinue |
      Where-Object { $_.Subject -eq "CN=Vivimagic" -and $_.HasPrivateKey -and $_.NotAfter -gt (Get-Date) } |
      Select-Object -First 1

    if (-not $signingCert) {
      $signingCert = New-SelfSignedCertificate -Type CodeSigningCert -Subject "CN=Vivimagic" -FriendlyName "Vivimagic Code Signing Certificate" -CertStoreLocation "Cert:\LocalMachine\My" -HashAlgorithm SHA256 -NotAfter (Get-Date).AddYears(5)
    }

    $publicCer = Join-Path $WorkDir "Vivimagic-Publisher.cer"
    Export-Certificate -Cert $signingCert -FilePath $publicCer -Force | Out-Null
    Import-Certificate -FilePath $publicCer -CertStoreLocation "Cert:\LocalMachine\Root" | Out-Null
    Import-Certificate -FilePath $publicCer -CertStoreLocation "Cert:\LocalMachine\TrustedPublisher" | Out-Null

    Set-AuthenticodeSignature -FilePath $OutExePath -Certificate $signingCert -HashAlgorithm SHA256 | Out-Null
  } else {
    Write-Host "[CI] Built $OutExePath (unsigned; supply VIVIMAGIC_PFX_BASE64 + VIVIMAGIC_PFX_PASSWORD secrets to Authenticode-sign)."
  }

  if (-not $isCi) {
    # Refresh Windows Explorer shell icon cache so the custom Vivimagic icon displays immediately
    try {
      Add-Type -Namespace VivimagicShell -Name Native -MemberDefinition '[System.Runtime.InteropServices.DllImport("shell32.dll")] public static extern void SHChangeNotify(int wEventId, int uFlags, System.IntPtr dwItem1, System.IntPtr dwItem2);'
      [VivimagicShell.Native]::SHChangeNotify(0x08000000, 0x0000, [System.IntPtr]::Zero, [System.IntPtr]::Zero)
    } catch {}

    # Launch the newly built signed GUI installer right away
    Start-Process -FilePath $OutExePath
  }
} finally {
  Remove-Item -Recurse -Force $WorkDir -ErrorAction SilentlyContinue
}
