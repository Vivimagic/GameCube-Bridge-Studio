        private static Label CreateFwLabel(Control parent, string text, int x, int y, int w, int h)
        {
            Label lbl = new Label();
            lbl.UseMnemonic = false;
            lbl.Text = text;
            lbl.Font = new Font("Segoe UI", 7.75F, FontStyle.Bold);
            lbl.Location = new Point(x, y);
            lbl.Size = new Size(w, h);
            parent.Controls.Add(lbl);
            return lbl;
        }

        private void SelectFwSubTab(int index)
        {
            activeFwSubTab = index;
            fwPageConfig.Visible = (index == 0);
            fwPageSdk.Visible = (index == 1);
            fwPageInspect.Visible = (index == 2);
            if (index == 1)
            {
                RefreshFirmwareSdkCode();
            }
            UpdateFwSubTabStyles();
        }

        private void UpdateFwSubTabStyles()
        {
            Button[] tabs = new Button[] { btnFwTabConfig, btnFwTabSdk, btnFwTabInspect };
            for (int i = 0; i < tabs.Length; i++)
            {
                if (tabs[i] == null) continue;
                bool active = (i == activeFwSubTab);
                if (isDarkMode)
                {
                    tabs[i].BackColor = active ? Color.FromArgb(79, 70, 229) : Color.FromArgb(15, 23, 42);
                    tabs[i].ForeColor = active ? Color.White : Color.FromArgb(203, 213, 225);
                    tabs[i].FlatAppearance.BorderColor = active ? Color.FromArgb(129, 140, 248) : Color.FromArgb(71, 85, 105);
                }
                else
                {
                    tabs[i].BackColor = active ? Color.FromArgb(79, 70, 229) : Color.FromArgb(248, 250, 252);
                    tabs[i].ForeColor = active ? Color.White : Color.FromArgb(51, 65, 85);
                    tabs[i].FlatAppearance.BorderColor = active ? Color.FromArgb(67, 56, 202) : Color.FromArgb(203, 213, 225);
                }
            }
        }

        private void ApplyCommunityPreset(int idx)
        {
            suppressFwEvents = true;
            try
            {
                if (idx == 0)
                {
                    txtFwName.Text = "OpenGC-XInput-1000Hz";
                    txtFwAuthor.Text = "Vivimagic";
                    txtFwVersion.Text = "1.0.0";
                    cmbFwTarget.SelectedIndex = 0;
                    cmbFwPersonality.SelectedIndex = 0;
                    cmbFwPollHz.SelectedIndex = 3;
                    cmbFwPwmHz.SelectedIndex = 1;
                    cmbFwRecovery.SelectedIndex = 0;
                    numFwSnapback.Value = 6;
                    chkFwLed.Checked = true;
                    cmbFwPreset.SelectedIndex = 0;
                }
                else if (idx == 1)
                {
                    txtFwName.Text = "OpenGC-DualMode-Switch";
                    txtFwAuthor.Text = "OpenGC Community";
                    txtFwVersion.Text = "1.1.0";
                    cmbFwTarget.SelectedIndex = 0;
                    cmbFwPersonality.SelectedIndex = 1;
                    cmbFwPollHz.SelectedIndex = 3;
                    cmbFwPwmHz.SelectedIndex = 1;
                    cmbFwRecovery.SelectedIndex = 1;
                    numFwSnapback.Value = 8;
                    chkFwLed.Checked = true;
                    cmbFwPreset.SelectedIndex = 1;
                }
                else if (idx == 2)
                {
                    txtFwName.Text = "OpenGC-Snapback-Pro";
                    txtFwAuthor.Text = "MeleeLab";
                    txtFwVersion.Text = "1.0.2";
                    cmbFwTarget.SelectedIndex = 1;
                    cmbFwPersonality.SelectedIndex = 1;
                    cmbFwPollHz.SelectedIndex = 3;
                    cmbFwPwmHz.SelectedIndex = 2;
                    cmbFwRecovery.SelectedIndex = 1;
                    numFwSnapback.Value = 14;
                    chkFwLed.Checked = false;
                    cmbFwPreset.SelectedIndex = 2;
                }
                else
                {
                    txtFwName.Text = "OpenGC-Classic-125Hz";
                    txtFwAuthor.Text = "RetroArchival";
                    txtFwVersion.Text = "1.0.0";
                    cmbFwTarget.SelectedIndex = 0;
                    cmbFwPersonality.SelectedIndex = 0;
                    cmbFwPollHz.SelectedIndex = 0;
                    cmbFwPwmHz.SelectedIndex = 0;
                    cmbFwRecovery.SelectedIndex = 0;
                    numFwSnapback.Value = 0;
                    chkFwLed.Checked = true;
                    cmbFwPreset.SelectedIndex = 3;
                }
            }
            finally
            {
                suppressFwEvents = false;
            }
            lblFwConfigHint.Text = "Loaded preset: " + txtFwName.Text + " (" + GetSelectedPollHz() + " Hz, " + GetSelectedPwmHz() + " Hz PWM).";
            RefreshFirmwareSdkCode();
        }

