                    if (key != null) key.SetValue("DarkMode", dark ? 1 : 0, RegistryValueKind.DWord);
                }
            }
            catch { }
        }

        private static bool ReadSystemTrayEnabled(bool fallback)
        {
            try
            {
                string raw = ReadTextShared(LiveConfigFilePath);
                if (!string.IsNullOrEmpty(raw))
                {
                    string[] lines = raw.Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                    for (int i = lines.Length - 1; i >= 0; i--)
                    {
                        string cl = lines[i].Trim('\uFEFF', ' ', '\t');
                        if (cl.StartsWith("EnableSystemTray=", StringComparison.OrdinalIgnoreCase))
                        {
                            string v = cl.Substring("EnableSystemTray=".Length).Trim();
                            return (string.Equals(v, "true", StringComparison.OrdinalIgnoreCase) || v == "1");
                        }
                    }
                }
            }
            catch { }
            try
            {
                using (RegistryKey key = Registry.CurrentUser.OpenSubKey(@"Software\Vivimagic\GCBridgeW012"))
                {
                    if (key != null)
                    {
                        object val = key.GetValue("EnableSystemTray");
                        if (val is int) return ((int)val != 0);
                        if (val is string)
                        {
                            string s = ((string)val).Trim().ToLowerInvariant();
                            return (s == "true" || s == "1");
                        }
                    }
                }
            }
            catch { }
            return fallback;
        }

        private static void WriteSystemTrayEnabled(bool enabled)
        {
            // 1. Always persist to HKCU registry (works even before first install or if ProgramData is temporarily busy)
            try
            {
                using (RegistryKey key = Registry.CurrentUser.CreateSubKey(@"Software\Vivimagic\GCBridgeW012"))
                {
                    if (key != null) key.SetValue("EnableSystemTray", enabled ? 1 : 0, RegistryValueKind.DWord);
                }
            }
            catch { }

            // 2. Persist to ProgramData live_config.ini with shared-access retries so VivimagicBridge hot-reloads within 200ms
            try
            {
                string dir = Path.GetDirectoryName(LiveConfigFilePath);
                if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
                List<string> outLines = new List<string>();
                string existingRaw = ReadTextShared(LiveConfigFilePath);
                if (!string.IsNullOrEmpty(existingRaw))
                {
                    string[] existing = existingRaw.Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                    for (int i = 0; i < existing.Length; i++)
                    {
                        string cl = existing[i].Trim('\uFEFF', ' ', '\t');
                        if (cl.Length == 0) continue;
                        if (cl.StartsWith("EnableSystemTray=", StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }
                        outLines.Add(cl);
                    }
                }
                outLines.Add("EnableSystemTray=" + (enabled ? "true" : "false"));
                string payload = string.Join(Environment.NewLine, outLines.ToArray()) + Environment.NewLine;

                for (int attempt = 0; attempt < 8; attempt++)
                {
                    try
                    {
                        using (FileStream fs = new FileStream(LiveConfigFilePath, FileMode.Create, FileAccess.Write, FileShare.ReadWrite | FileShare.Delete))
                        using (StreamWriter sw = new StreamWriter(fs, new UTF8Encoding(false)))
                        {
                            sw.Write(payload);
                        }
                        break;
                    }
                    catch
                    {
                        if (attempt < 7) Thread.Sleep(30);
                    }
                }
            }
            catch { }
        }

        private static string ExtractJsonStringField(string json, string key)
        {
            if (string.IsNullOrEmpty(json) || string.IsNullOrEmpty(key)) return "";
            string token = "\"" + key + "\"";
            int idx = json.IndexOf(token, StringComparison.OrdinalIgnoreCase);
            if (idx < 0) return "";
            int colon = json.IndexOf(':', idx + token.Length);
            if (colon < 0) return "";
            int q1 = json.IndexOf('"', colon + 1);
            if (q1 < 0) return "";
            int q2 = json.IndexOf('"', q1 + 1);
            if (q2 <= q1) return "";
            return json.Substring(q1 + 1, q2 - q1 - 1);
        }

        private static string FindExeDownloadUrl(string json)
        {
            if (string.IsNullOrEmpty(json)) return "";
            int pos = 0;
            string token = "\"browser_download_url\"";
            while (pos >= 0 && pos < json.Length)
            {
                int idx = json.IndexOf(token, pos, StringComparison.OrdinalIgnoreCase);
                if (idx < 0) break;
                int colon = json.IndexOf(':', idx + token.Length);
                if (colon < 0) break;
                int q1 = json.IndexOf('"', colon + 1);
                if (q1 < 0) break;
                int q2 = json.IndexOf('"', q1 + 1);
                if (q2 <= q1) break;
                string url = json.Substring(q1 + 1, q2 - q1 - 1);
                if (url.EndsWith(".exe", StringComparison.OrdinalIgnoreCase))
                {
                    return url;
                }
                pos = q2 + 1;
            }
            return "";
        }

        private static Version ParseLooseVersion(string tag)
        {
            try
            {
                string clean = (tag ?? "").Trim();
                if (clean.StartsWith("v", StringComparison.OrdinalIgnoreCase)) clean = clean.Substring(1);
                int dash = clean.IndexOf('-');
                if (dash > 0) clean = clean.Substring(0, dash);
                string[] parts = clean.Split('.');
                int maj = parts.Length > 0 ? int.Parse(parts[0]) : 0;
                int min = parts.Length > 1 ? int.Parse(parts[1]) : 0;
                int bld = parts.Length > 2 ? int.Parse(parts[2]) : 0;
                return new Version(maj, min, bld);
            }
            catch
            {
                return new Version(0, 0, 0);
            }
        }

        private static string FetchGitHubReleaseJson(out bool repoExistsNoReleases, out bool isNotFound)
        {
            repoExistsNoReleases = false;
            isNotFound = false;
            string[] urls = new string[]
            {
                "https://api.github.com/repos/Vivimagic/GameCube-Bridge-Studio/releases/latest",
                "https://api.github.com/repos/Vivimagic/GameCube-Bridge-Studio/releases?per_page=1"
            };
            for (int i = 0; i < urls.Length; i++)
            {
                try
                {
                    HttpWebRequest req = (HttpWebRequest)WebRequest.Create(urls[i]);
                    req.UserAgent = "Vivimagic-GC-Suite/2.0.0";
                    req.Accept = "application/vnd.github+json";
                    req.Timeout = 10000;
                    using (HttpWebResponse resp = (HttpWebResponse)req.GetResponse())
                    using (StreamReader sr = new StreamReader(resp.GetResponseStream(), Encoding.UTF8))
                    {
                        string body = sr.ReadToEnd();
                        string trimmed = (body ?? "").Trim();
                        if (i == 1 && (trimmed == "[]" || trimmed.Length < 4))
                        {
                            repoExistsNoReleases = true;
                            return "";
                        }
                        return body;
                    }
                }
                catch (WebException wex)
                {
                    HttpWebResponse errResp = wex.Response as HttpWebResponse;
                    if (errResp != null && errResp.StatusCode == HttpStatusCode.NotFound)
                    {
                        if (i == 0)
                        {
                            continue;
                        }
                        isNotFound = true;
                        return "";
                    }
                    throw;
                }
            }
            return "";
        }

        private void CheckForUpdatesAsync()
        {
            if (isCheckingUpdate || isDownloadingUpdate) return;
            isCheckingUpdate = true;
            btnCheckUpdate.Enabled = false;
            btnDownloadUpdate.Visible = false;
            lblUpdateStatus.Text = "Checking GitHub Releases for Vivimagic GC Suite updates...";

            Thread t = new Thread(delegate()
            {
                string statusText = "";
                bool showDownload = false;
                string foundTag = "";
                string foundExe = "";
                string foundPage = "https://github.com/Vivimagic/GameCube-Bridge-Studio/releases";
                try
                {
                    ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;
                    bool repoExistsNoReleases;
                    bool isNotFound;
                    string json = FetchGitHubReleaseJson(out repoExistsNoReleases, out isNotFound);
                    if (repoExistsNoReleases)
                    {
                        statusText = "Connected to GitHub, but no Release is published yet on Vivimagic/GameCube-Bridge-Studio.";
                        showDownload = true;
                    }
                    else if (isNotFound)
                    {
                        statusText = "No public Release found at Vivimagic/GameCube-Bridge-Studio (set repo Public & publish a Release).";
                        showDownload = true;
                    }
                    else
                    {
                        foundTag = ExtractJsonStringField(json, "tag_name");
                        string htmlUrl = ExtractJsonStringField(json, "html_url");
                        if (!string.IsNullOrEmpty(htmlUrl)) foundPage = htmlUrl;
                        foundExe = FindExeDownloadUrl(json);

                        Version latest = ParseLooseVersion(foundTag);
                        Version current = new Version(2, 0, 0);
                        if (latest > current)
                        {
                            statusText = "Update available: " + foundTag + " - click Download & Update to install.";
                            showDownload = true;
                        }
                        else if (!string.IsNullOrEmpty(foundTag))
                        {
                            statusText = "You are up to date (Installed: v2.0.0, Latest: " + foundTag + ").";
                            showDownload = !string.IsNullOrEmpty(foundExe);
                        }
                        else
                        {
                            statusText = "No published GitHub Release tag found yet on Vivimagic/GameCube-Bridge-Studio.";
                            showDownload = true;
                        }
                    }
                }
                catch (Exception ex)
                {
                    statusText = "Could not check automatically (" + ex.Message + ").";
                    showDownload = true;
                }

                if (!IsDisposed && IsHandleCreated)
                {
                    BeginInvoke((MethodInvoker)delegate
                    {
                        isCheckingUpdate = false;
                        latestUpdateTag = foundTag;
                        latestUpdateExeUrl = foundExe;
                        latestUpdatePageUrl = foundPage;
                        lblUpdateStatus.Text = statusText;
                        btnCheckUpdate.Enabled = true;
                        btnDownloadUpdate.Visible = showDownload;
                        btnDownloadUpdate.Text = !string.IsNullOrEmpty(foundExe) ? "Download & Update" : "Open Releases";
                    });
                }
            });
            t.IsBackground = true;
            t.Start();
        }

        private void DownloadAndLaunchUpdateAsync()
        {
            if (isDownloadingUpdate) return;
            if (string.IsNullOrEmpty(latestUpdateExeUrl))
            {
                try
                {
                    ProcessStartInfo psi = new ProcessStartInfo(latestUpdatePageUrl);
                    psi.UseShellExecute = true;
                    Process.Start(psi);
                }
                catch { }
                return;
            }

            isDownloadingUpdate = true;
            btnCheckUpdate.Enabled = false;
            btnDownloadUpdate.Enabled = false;
            lblUpdateStatus.Text = "Downloading update " + (string.IsNullOrEmpty(latestUpdateTag) ? "" : latestUpdateTag) + "...";

            string targetExe = Path.Combine(Path.GetTempPath(), "Vivimagic GC Suite.exe");
            Thread t = new Thread(delegate()
            {
                string err = "";
                try
                {
                    ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;
                    using (WebClient wc = new WebClient())
                    {
                        wc.Headers.Add("User-Agent", "Vivimagic-GC-Suite/2.0.0");
                        wc.DownloadProgressChanged += delegate(object sender, DownloadProgressChangedEventArgs e)
                        {
                            if (!IsDisposed && IsHandleCreated)
                            {
                                int pct = e.ProgressPercentage;
                                BeginInvoke((MethodInvoker)delegate
                                {
                                    lblUpdateStatus.Text = "Downloading update... " + pct + "%";
                                });
                            }
                        };
                        using (ManualResetEvent done = new ManualResetEvent(false))
                        {
                            wc.DownloadFileCompleted += delegate(object sender, System.ComponentModel.AsyncCompletedEventArgs e)
                            {
                                if (e.Error != null) err = e.Error.Message;
                                try { done.Set(); } catch { }
                            };
                            wc.DownloadFileAsync(new Uri(latestUpdateExeUrl), targetExe);
                            if (!done.WaitOne(120000))
                            {
                                try { wc.CancelAsync(); } catch { }
                                err = "Download timed out after 120 seconds.";
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    err = ex.Message;
                }

                if (!IsDisposed && IsHandleCreated)
                {
                    BeginInvoke((MethodInvoker)delegate
                    {
                        isDownloadingUpdate = false;
                        btnCheckUpdate.Enabled = true;
                        btnDownloadUpdate.Enabled = true;
                        if (string.IsNullOrEmpty(err) && File.Exists(targetExe))
                        {
                            lblUpdateStatus.Text = "Update downloaded. Launching Vivimagic GC Suite installer...";
                            try
                            {
                                ProcessStartInfo psi = new ProcessStartInfo(targetExe);
                                psi.UseShellExecute = true;
                                Process.Start(psi);
                                Close();
                                if (onCloseParentForUpdate != null) onCloseParentForUpdate();
                            }
                            catch (Exception launchEx)
                            {
                                lblUpdateStatus.Text = "Downloaded to TEMP, launch failed: " + launchEx.Message;
                            }
                        }
                        else
                        {
                            lblUpdateStatus.Text = "Download failed (" + (string.IsNullOrEmpty(err) ? "timeout" : err) + ").";
                        }
                    });
                }
            });
            t.IsBackground = true;
            t.Start();
        }
    }

