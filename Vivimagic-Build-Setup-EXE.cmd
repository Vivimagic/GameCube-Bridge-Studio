        private void StartPolling()
        {
            if (pollRunning) return;
            lock (pollLock)
            {
                for (int i = 0; i < 4; i++) padInputPulse[i] = false;
            }
            pollRunning = true;
            pollGen++;
            int gen = pollGen;
            pollThread = new Thread(delegate() { PollLoop(gen); });
            pollThread.IsBackground = true;
            pollThread.Start();
            uiTimer.Start();
        }

        private void StopPolling()
        {
            pollRunning = false;
            pollGen++;
            try { uiTimer.Stop(); } catch { }
            try
            {
                if (pollThread != null && pollThread.IsAlive)
                {
                    pollThread.Join(200);
                }
            }
            catch { }
            try { wupUsb.Close(); } catch { }
            if (createdDirectLock)
            {
                ReleaseDirectLock();
            }
        }

        private static short ByteAxisToShort(byte val)
        {
            int centered = ((int)val - 128) * 256;
            if (centered > 32767) return 32767;
            if (centered < -32768) return -32768;
            return (short)centered;
        }

        private static bool UpdateStickEngaged(short x, short y, ref bool engaged)
        {
            long lx = (long)x;
            long ly = (long)y;
            long magSq = lx * lx + ly * ly;
            // 45% radial deadzone engage (~14745) and 30% release (~9830) to ignore natural stick drift
            const long engageSq = 14745L * 14745L;
            const long releaseSq = 9830L * 9830L;
            if (engaged)
            {
                if (magSq < releaseSq) engaged = false;
                return false;
            }
            if (magSq > engageSq)
            {
                engaged = true;
                return true;
            }
            return false;
        }

        private static bool ParseBridgeXMap(string bStat, int[] physToXSlot)
        {
            for (int i = 0; i < 4; i++) physToXSlot[i] = -1;
            if (string.IsNullOrEmpty(bStat)) return false;
            int idx = bStat.IndexOf("|xmap=");
            if (idx < 0) return false;
            string mapPart = bStat.Substring(idx + 6);
            int nextBar = mapPart.IndexOf('|');
            if (nextBar >= 0) mapPart = mapPart.Substring(0, nextBar);
            string[] pairs = mapPart.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
            bool any = false;
            for (int i = 0; i < pairs.Length; i++)
            {
                string[] kv = pairs[i].Split(':');
                int phys, xslot;
                if (kv.Length == 2 && int.TryParse(kv[0], out phys) && int.TryParse(kv[1], out xslot))
                {
                    if (phys >= 1 && phys <= 4 && xslot >= 0 && xslot <= 3)
                    {
                        physToXSlot[phys - 1] = xslot;
                        any = true;
                    }
                }
            }
            return any;
        }

        private void PollLoop(int myGen)
        {
            uint[] lastPkt = new uint[4];
            byte[] lastLT = new byte[4];
            byte[] lastRT = new byte[4];
            byte[] baseLT = new byte[] { 255, 255, 255, 255 };
            byte[] baseRT = new byte[] { 255, 255, 255, 255 };
            int[] pktCounts = new int[4];
            int[] trigCounts = new int[4];
            ushort[] prevBtns = new ushort[4];
            bool[] prevTrig = new bool[4];
            bool[] prevLStick = new bool[4];
            bool[] prevRStick = new bool[4];
            bool[] prevConn = new bool[4];
            int[] physToXSlot = new int[] { 0, 1, 2, 3 };
            byte[] wupBuf = new byte[37];
            Stopwatch sw = Stopwatch.StartNew();
            long lastWindowMs = 0;
            long lastStatusReadMs = -1000;
            string cachedBridgeStatus = "";
            long noXInputSinceMs = sw.ElapsedMilliseconds;
            bool lastSentRumbleState = false;
            int lastSentRumblePort = -1;
            long lastPwmToggleMs = 0;
            bool pwmPhaseOn = true;

            while (pollRunning && myGen == pollGen)
            {
                long loopMs = sw.ElapsedMilliseconds;
                if (loopMs - lastStatusReadMs >= 160)
                {
                    cachedBridgeStatus = ReadBridgeStatus();
                    lastStatusReadMs = loopMs;
                }

                // 1. Check XInput (4-Port ViGEmBus + VivimagicBridge layer) mapped back to exact physical Mayflash W012 ports (P1-P4)
                bool anyXInput = false;
                if (!wupUsb.IsOpen)
                {
                    bool hasXMap = ParseBridgeXMap(cachedBridgeStatus, physToXSlot);
                    if (!hasXMap && cachedBridgeStatus.StartsWith("READY|"))
                    {
                        // Refresh immediately if a controller just plugged in so physical port lights up with zero flicker
                        XINPUT_STATE probe;
                        if (NativeXInput.GetState(0, out probe) == 0)
                        {
                            cachedBridgeStatus = ReadBridgeStatus();
                            lastStatusReadMs = loopMs;
                            hasXMap = ParseBridgeXMap(cachedBridgeStatus, physToXSlot);
                        }
                    }

                    for (int phys = 0; phys < 4; phys++)
                    {
                        int xSlot = hasXMap ? physToXSlot[phys] : phys;
                        XINPUT_STATE st = new XINPUT_STATE();
                        bool ok = (xSlot >= 0 && xSlot < 4) && (NativeXInput.GetState((uint)xSlot, out st) == 0);
                        bool pulse = false;
                        if (ok)
                        {
                            anyXInput = true;
                            if (st.dwPacketNumber != lastPkt[phys])
                            {
                                pktCounts[phys]++;
                                lastPkt[phys] = st.dwPacketNumber;
                            }
                            if (st.Gamepad.bLeftTrigger != lastLT[phys] || st.Gamepad.bRightTrigger != lastRT[phys])
                            {
                                trigCounts[phys]++;
                                lastLT[phys] = st.Gamepad.bLeftTrigger;
                                lastRT[phys] = st.Gamepad.bRightTrigger;
                            }
                            bool trigNow = (st.Gamepad.bLeftTrigger > 120 || st.Gamepad.bRightTrigger > 120);
                            bool lStickRise = UpdateStickEngaged(st.Gamepad.sThumbLX, st.Gamepad.sThumbLY, ref prevLStick[phys]);
                            bool rStickRise = UpdateStickEngaged(st.Gamepad.sThumbRX, st.Gamepad.sThumbRY, ref prevRStick[phys]);
                            if (prevConn[phys] && (((st.Gamepad.wButtons & ~prevBtns[phys]) != 0) || (trigNow && !prevTrig[phys]) || lStickRise || rStickRise))
                            {
                                pulse = true;
                            }
                            prevBtns[phys] = st.Gamepad.wButtons;
                            prevTrig[phys] = trigNow;
                            prevConn[phys] = true;
                        }
                        else
                        {
                            prevBtns[phys] = 0;
                            prevTrig[phys] = false;
                            prevLStick[phys] = false;
                            prevRStick[phys] = false;
                            prevConn[phys] = false;
                        }
                        lock (pollLock)
                        {
                            padConnected[phys] = ok;
                            padXInputSlot[phys] = (xSlot >= 0 && xSlot < 4) ? xSlot : phys;
                            padRumblePower[phys] = true;
                            padStates[phys] = st;
                            if (pulse) padInputPulse[phys] = true;
                            else if (!ok) padInputPulse[phys] = false;
                        }
                    }
                }

                if (anyXInput)
                {
                    noXInputSinceMs = sw.ElapsedMilliseconds;
                    lock (pollLock)
                    {
                        usingDirectWinUsb = false;
                        blockedReason = "";
                        blockedEmulator = "";
                    }
                    Thread.Sleep(2);
                }
                else
                {
                    // 2. Respect VivimagicBridge! When the native XInput bridge is running with ViGEmBus,
                    // NEVER steal WinUSB or create tester_direct.lock — let Steam & XInput stay connected!
                    bool bridgeRunning = IsBridgeRunning();
                    string bStat = ReadBridgeStatus();
                    bool allowDirectFallback = (!bridgeRunning) || bStat.StartsWith("NO_VIGEM");

                    if (!allowDirectFallback)
                    {
                        if (wupUsb.IsOpen)
                        {
                            wupUsb.Close();
                            lastSentRumbleState = false;
                        }
                        if (createdDirectLock)
                        {
                            ReleaseDirectLock();
                        }

                        string hintMsg = "";
                        string blockingEmu = "";
                        string emu = FindBlockingEmulatorName();
                        if (!string.IsNullOrEmpty(emu))
                        {
                            blockingEmu = emu;
                            hintMsg = emu + " is running and holding the adapter. Close " + emu + " to test controllers.";
                        }
                        else if (bStat.StartsWith("YIELDED|"))
                        {
                            string yieldedProc = bStat.Substring(8).Trim();
                            if (!string.IsNullOrEmpty(yieldedProc) && !string.Equals(yieldedProc, "SetupTester", StringComparison.OrdinalIgnoreCase))
                            {
                                blockingEmu = yieldedProc;
                                hintMsg = yieldedProc + " is running and holding the adapter. Close " + yieldedProc + " to test controllers.";
                            }
                            else
                            {
                                hintMsg = "Adapter yielded to " + yieldedProc + " (auto-handover active).";
                            }
                        }
                        else if (bStat.StartsWith("NO_ADAPTER|err=5") || bStat.StartsWith("NO_ADAPTER|err=32"))
                        {
                            hintMsg = "WinUSB busy (another app such as Steam GameCube driver or Dolphin holds 057E:0337). Unplug & replug the adapter so Vivimagic XInput claims it.";
                        }
                        else if (bStat.StartsWith("PLUGIN_ERR") || bStat.StartsWith("SUBMIT_ERR"))
                        {
                            hintMsg = "ViGEmBus notice (" + bStat + ") — Restart Windows once or click Reinstall Fresh Settings.";
                        }
                        else if (bStat.StartsWith("ACTIVE|"))
                        {
                            hintMsg = "Xbox 360 virtual controllers enumerating (" + bStat + ") — Steam & XInput activating...";
                        }

                        lock (pollLock)
                        {
                            usingDirectWinUsb = false;
                            blockedReason = hintMsg;
                            blockedEmulator = blockingEmu;
                        }
                        Thread.Sleep(150);
                    }
                    else
                    {
                        // Direct Native WUP-028 WinUSB Fallback (only when VivimagicBridge is stopped or ViGEmBus needs reboot)
                        if (!wupUsb.IsOpen)
                        {
                            int openErr;
                            if (wupUsb.Open(out openErr))
                            {
                                lock (pollLock)
                                {
                                    usingDirectWinUsb = true;
                                    blockedReason = "";
                                    blockedEmulator = "";
                                }
                            }
                            else if (openErr == 5 || openErr == 32)
                            {
                                string emu = FindBlockingEmulatorName();
                                if (!string.IsNullOrEmpty(emu))
                                {
                                    lock (pollLock)
                                    {
                                        usingDirectWinUsb = false;
                                        blockedEmulator = emu;
                                        blockedReason = emu + " is running and holding the adapter. Close " + emu + " to test controllers.";
                                    }
                                    Thread.Sleep(350);
                                }
                                else if (bridgeRunning && bStat.StartsWith("NO_VIGEM") && (sw.ElapsedMilliseconds - noXInputSinceMs) >= 1200)
                                {
                                    lock (pollLock)
                                    {
                                        blockedEmulator = "";
                                        blockedReason = "Opening direct WUP-028 hardware test (ViGEmBus pending reboot)...";
                                    }
                                    AcquireDirectLock();
                                    Thread.Sleep(450);
                                }
                                else
                                {
                                    lock (pollLock)
                                    {
                                        blockedEmulator = "";
                                        blockedReason = "WinUSB busy — close Dolphin or unplug & replug adapter.";
                                    }
                                    Thread.Sleep(250);
                                }
                            }
                            else
                            {
                                for (int i = 0; i < 4; i++)
                                {
                                    prevBtns[i] = 0;
                                    prevTrig[i] = false;
                                    prevLStick[i] = false;
                                    prevRStick[i] = false;
                                    prevConn[i] = false;
                                }
                                lock (pollLock)
                                {
                                    usingDirectWinUsb = false;
                                    blockedReason = "";
                                    blockedEmulator = "";
                                    for (int i = 0; i < 4; i++)
                                    {
                                        padConnected[i] = false;
                                        padInputPulse[i] = false;
                                    }
                                }
                                Thread.Sleep(250);
                            }
                        }
                    }

                    if (wupUsb.IsOpen)
                    {
                        int readErr;
                        if (wupUsb.ReadReport(wupBuf, out readErr))
                        {
                            for (int p = 0; p < 4; p++)
                            {
                                int o = 1 + (p * 9);
                                byte status = wupBuf[o];
                                bool conn = (status & 0x30) != 0;
                                bool hasRumblePwr = (status & 0x04) != 0;
                                XINPUT_STATE st = new XINPUT_STATE();

                                bool pulse = false;
                                if (conn)
                                {
                                    byte b1 = wupBuf[o + 1];
                                    byte b2 = wupBuf[o + 2];
                                    ushort mask = 0;
                                    if ((b1 & 0x01) != 0) mask |= 0x1000; // A
                                    if ((b1 & 0x02) != 0) mask |= 0x2000; // B
                                    if ((b1 & 0x04) != 0) mask |= 0x4000; // X
                                    if ((b1 & 0x08) != 0) mask |= 0x8000; // Y
                                    if ((b1 & 0x10) != 0) mask |= 0x0004; // LEFT
                                    if ((b1 & 0x20) != 0) mask |= 0x0008; // RIGHT
                                    if ((b1 & 0x40) != 0) mask |= 0x0002; // DOWN
                                    if ((b1 & 0x80) != 0) mask |= 0x0001; // UP
                                    if ((b2 & 0x01) != 0) mask |= 0x0010; // START
                                    if ((b2 & 0x02) != 0) mask |= 0x0200; // Z

                                    st.Gamepad.wButtons = mask;
                                    st.Gamepad.sThumbLX = ByteAxisToShort(wupBuf[o + 3]);
                                    st.Gamepad.sThumbLY = ByteAxisToShort(wupBuf[o + 4]);
                                    st.Gamepad.sThumbRX = ByteAxisToShort(wupBuf[o + 5]);
                                    st.Gamepad.sThumbRY = ByteAxisToShort(wupBuf[o + 6]);
                                    byte rawLT = wupBuf[o + 7];
                                    byte rawRT = wupBuf[o + 8];
                                    if (rawLT < baseLT[p] && (rawLT > 0 || baseLT[p] <= 12 || baseLT[p] == 255)) baseLT[p] = rawLT;
                                    if (rawRT < baseRT[p] && (rawRT > 0 || baseRT[p] <= 12 || baseRT[p] == 255)) baseRT[p] = rawRT;
                                    int adjLT = rawLT - baseLT[p];
                                    int adjRT = rawRT - baseRT[p];
                                    double normLT = adjLT > 3 ? (double)(adjLT - 3) / Math.Max(40.0, 210.0 - baseLT[p]) : 0.0;
                                    double normRT = adjRT > 3 ? (double)(adjRT - 3) / Math.Max(40.0, 210.0 - baseRT[p]) : 0.0;
                                    if (normLT > 1.0) normLT = 1.0;
                                    if (normRT > 1.0) normRT = 1.0;
                                    st.Gamepad.bLeftTrigger = (byte)Math.Round(normLT * 255.0);
                                    st.Gamepad.bRightTrigger = (byte)Math.Round(normRT * 255.0);

                                    pktCounts[p]++;
                                    if (st.Gamepad.bLeftTrigger != lastLT[p] || st.Gamepad.bRightTrigger != lastRT[p])
                                    {
                                        trigCounts[p]++;
                                        lastLT[p] = st.Gamepad.bLeftTrigger;
                                        lastRT[p] = st.Gamepad.bRightTrigger;
                                    }

                                    bool trigNow = (st.Gamepad.bLeftTrigger > 120 || st.Gamepad.bRightTrigger > 120);
                                    bool lStickRise = UpdateStickEngaged(st.Gamepad.sThumbLX, st.Gamepad.sThumbLY, ref prevLStick[p]);
                                    bool rStickRise = UpdateStickEngaged(st.Gamepad.sThumbRX, st.Gamepad.sThumbRY, ref prevRStick[p]);
                                    if (prevConn[p] && (((mask & ~prevBtns[p]) != 0) || (trigNow && !prevTrig[p]) || lStickRise || rStickRise))
                                    {
                                        pulse = true;
                                    }
                                    prevBtns[p] = mask;
                                    prevTrig[p] = trigNow;
                                    prevConn[p] = true;
                                }
                                else
                                {
                                    prevBtns[p] = 0;
                                    prevTrig[p] = false;
                                    prevLStick[p] = false;
                                    prevRStick[p] = false;
                                    prevConn[p] = false;
                                    baseLT[p] = 255;
                                    baseRT[p] = 255;
                                }

                                lock (pollLock)
                                {
                                    padConnected[p] = conn;
                                    padRumblePower[p] = hasRumblePwr;
                                    padStates[p] = st;
                                    usingDirectWinUsb = true;
                                    blockedReason = "";
                                    if (pulse) padInputPulse[p] = true;
                                    else if (!conn) padInputPulse[p] = false;
                                }
                            }

                            // Drive direct 0x11 WUP-028 hardware rumble (with 50% PWM option for Right Light)
                            bool wantOn = false;
                            int rPort = activeRumblePort;
                            if (activeLeftMotor > 0)
                            {
                                wantOn = true;
                            }
                            else if (activeRightMotor > 0)
                            {
                                long curMs = sw.ElapsedMilliseconds;
                                if (curMs - lastPwmToggleMs >= 40)
                                {
                                    pwmPhaseOn = !pwmPhaseOn;
                                    lastPwmToggleMs = curMs;
                                }
                                wantOn = pwmPhaseOn;
                            }

                            if (wantOn != lastSentRumbleState || (wantOn && rPort != lastSentRumblePort))
                            {
                                wupUsb.SendRumble(
                                    wantOn && rPort == 0,
                                    wantOn && rPort == 1,
                                    wantOn && rPort == 2,
                                    wantOn && rPort == 3
                                );
                                lastSentRumbleState = wantOn;
                                lastSentRumblePort = rPort;
                            }
                        }
                        else if (readErr != 0 && readErr != 121 && readErr != 995)
                        {
                            // Device unplugged or reset
                            wupUsb.Close();
                            lastSentRumbleState = false;
                            Thread.Sleep(150);
                        }
                    }
                }

                long nowMs = sw.ElapsedMilliseconds;
                if (nowMs - lastWindowMs >= 500)
                {
                    double secs = (nowMs - lastWindowMs) / 1000.0;
                    if (secs < 0.05) secs = 0.5;
                    lock (pollLock)
                    {
                        for (int i = 0; i < 4; i++)
                        {
                            padPacketHz[i] = (int)Math.Round(pktCounts[i] / secs);
                            padTrigHz[i] = (int)Math.Round(trigCounts[i] / secs);
                            pktCounts[i] = 0;
                            trigCounts[i] = 0;
                        }
                    }
                    lastWindowMs = nowMs;
                }
            }

            wupUsb.Close();
        }

        private void TriggerRumble(ushort leftMotor, ushort rightMotor, int durationMs)
        {
            bool connected;
            bool directMode;
            bool hasRumblePwr;
            int xSlot;
            lock (pollLock)
            {
                connected = padConnected[selectedPort];
                directMode = usingDirectWinUsb;
                hasRumblePwr = padRumblePower[selectedPort];
                xSlot = padXInputSlot[selectedPort];
            }
            if (!connected)
            {
                lblPadHint.Text = "Connect a controller on P" + (selectedPort + 1) + " first to test vibration motors.";
                return;
            }
            activeRumblePort = selectedPort;
            activeLeftMotor = leftMotor;
            activeRightMotor = rightMotor;
            rumbleStopTick = durationMs > 0 ? Environment.TickCount + durationMs : 0;

            if (directMode)
            {
                wupUsb.SendRumble(
                    selectedPort == 0 && (leftMotor > 0 || rightMotor > 0),
                    selectedPort == 1 && (leftMotor > 0 || rightMotor > 0),
                    selectedPort == 2 && (leftMotor > 0 || rightMotor > 0),
                    selectedPort == 3 && (leftMotor > 0 || rightMotor > 0)
                );
                if (!hasRumblePwr)
                {
                    lblPadHint.Text = "Rumble sent, but Gray 5V USB power was not detected — plug in BOTH Black & Gray USBs.";
                }
            }
            else
            {
                NativeXInput.SetState((uint)xSlot, leftMotor, rightMotor);
            }
            UpdateRumbleVisuals();
        }

        private void StopRumbleOnPort(int port)
        {
            int xSlot = port;
            lock (pollLock)
            {
                if (port >= 0 && port < 4) xSlot = padXInputSlot[port];
            }
            activeLeftMotor = 0;
            activeRightMotor = 0;
            rumbleStopTick = 0;
            try { NativeXInput.SetState((uint)xSlot, 0, 0); } catch { }
            try { wupUsb.SendRumble(false, false, false, false); } catch { }
            UpdateRumbleVisuals();
        }

        private void StopAllRumble()
        {
            activeLeftMotor = 0;
            activeRightMotor = 0;
            rumbleStopTick = 0;
            for (uint i = 0; i < 4; i++)
            {
                try { NativeXInput.SetState(i, 0, 0); } catch { }
            }
            try { wupUsb.SendRumble(false, false, false, false); } catch { }
            UpdateRumbleVisuals();
        }

        private void UpdateRumbleVisuals()
        {
            if (IsDisposed) return;
            bool running = activeLeftMotor > 0 || activeRightMotor > 0;
            if (running)
            {
                if (rumbleStopTick != 0)
                {
                    int remMs = unchecked(rumbleStopTick - Environment.TickCount);
                    if (remMs < 0) remMs = 0;
                    double remSec = Math.Ceiling(remMs / 100.0) / 10.0;
                    lblRumbleState.Text = remSec.ToString("0.0") + "s";
                }
                else
                {
                    lblRumbleState.Text = "ACTIVE";
                }
                lblRumbleState.BackColor = isDarkMode ? Color.FromArgb(6, 78, 59) : Color.FromArgb(209, 250, 229);
                lblRumbleState.ForeColor = isDarkMode ? Color.FromArgb(52, 211, 153) : Color.FromArgb(6, 95, 70);
            }
            else
            {
                lblRumbleState.Text = "IDLE";
                lblRumbleState.BackColor = isDarkMode ? Color.FromArgb(15, 23, 42) : Color.FromArgb(241, 245, 249);
                lblRumbleState.ForeColor = isDarkMode ? Color.FromArgb(148, 163, 184) : Color.FromArgb(100, 116, 139);
            }
        }

        private void RefreshTesterUi()
        {
            if (!testerVisible || IsDisposed) return;

            if (rumbleStopTick != 0)
            {
                if (unchecked(Environment.TickCount - rumbleStopTick) >= 0)
                {
                    StopRumbleOnPort(activeRumblePort);
                }
                else if (activeLeftMotor > 0 || activeRightMotor > 0)
                {
                    UpdateRumbleVisuals();
                }
            }

            bool[] conn = new bool[4];
            bool[] pulse = new bool[4];
            int[] allXSlots = new int[4];
            XINPUT_STATE[] allStates = new XINPUT_STATE[4];
            int[] allPktHz = new int[4];
            int[] allTrigHz = new int[4];
            bool[] allRumblePwr = new bool[4];
            bool directMode = false;
            string blocked = "";
            string blockingEmu = "";

            lock (pollLock)
            {
                for (int i = 0; i < 4; i++)
                {
                    conn[i] = padConnected[i];
                    pulse[i] = padInputPulse[i];
                    padInputPulse[i] = false;
                    allXSlots[i] = padXInputSlot[i];
                    allStates[i] = padStates[i];
                    allPktHz[i] = padPacketHz[i];
                    allTrigHz[i] = padTrigHz[i];
                    allRumblePwr[i] = padRumblePower[i];
                }
                directMode = usingDirectWinUsb;
                blocked = blockedReason;
                blockingEmu = blockedEmulator;
            }

            // Auto-switch to any connected controller when a button or trigger is pressed
            int switchTo = -1;
            for (int i = 0; i < 4; i++)
            {
                if (conn[i] && i != selectedPort && pulse[i])
                {
                    switchTo = i;
                    break;
                }
            }
            if (switchTo >= 0)
            {
                StopRumbleOnPort(selectedPort);
                selectedPort = switchTo;
            }
            else if (!conn[selectedPort])
            {
                for (int i = 0; i < 4; i++)
                {
                    if (conn[i])
                    {
                        StopRumbleOnPort(selectedPort);
                        selectedPort = i;
                        break;
                    }
                }
            }

            XINPUT_STATE selState = allStates[selectedPort];
            int pktHz = allPktHz[selectedPort];
            int trigHz = allTrigHz[selectedPort];
            bool hasRumblePwr = allRumblePwr[selectedPort];

            bool isConn = conn[selectedPort];
            uiHasSelectedPad = isConn;

            for (int i = 0; i < 4; i++)
            {
                Button pb = portButtons[i];
                bool selected = (i == selectedPort);
                pb.Text = (conn[i] ? "* P" : "P") + (i + 1);
                if (conn[i])
                {
                    pb.BackColor = selected
                        ? (isDarkMode ? Color.FromArgb(5, 150, 105) : Color.FromArgb(16, 185, 129))
                        : (isDarkMode ? Color.FromArgb(6, 78, 59) : Color.FromArgb(209, 250, 229));
                    pb.ForeColor = selected
                        ? Color.White
                        : (isDarkMode ? Color.FromArgb(167, 243, 208) : Color.FromArgb(6, 95, 70));
                    pb.FlatAppearance.BorderColor = selected
                        ? (isDarkMode ? Color.FromArgb(110, 231, 183) : Color.FromArgb(4, 120, 87))
                        : (isDarkMode ? Color.FromArgb(16, 185, 129) : Color.FromArgb(52, 211, 153));
                }
                else
                {
                    pb.BackColor = isDarkMode ? Color.FromArgb(15, 23, 42) : Color.FromArgb(248, 250, 252);
                    pb.ForeColor = isDarkMode ? Color.FromArgb(100, 116, 139) : Color.FromArgb(148, 163, 184);
                    pb.FlatAppearance.BorderColor = selected
                        ? (isDarkMode ? Color.FromArgb(99, 102, 241) : Color.FromArgb(79, 70, 229))
                        : (isDarkMode ? Color.FromArgb(51, 65, 85) : Color.FromArgb(226, 232, 240));
                }
            }

            uiBlockedEmulator = (!isConn && !string.IsNullOrEmpty(blockingEmu)) ? blockingEmu : "";

            if (isConn)
            {
                string tag = directMode ? "USB" : "XIn";
                lblPollStats.Text = tag + " " + pktHz + " Hz | Trig " + trigHz + " Hz";
                lblPollStats.ForeColor = (pktHz > 0 || trigHz > 0)
                    ? (isDarkMode ? Color.FromArgb(129, 140, 248) : Color.FromArgb(79, 70, 229))
                    : (isDarkMode ? Color.FromArgb(148, 163, 184) : Color.FromArgb(100, 116, 139));
            }
            else if (!string.IsNullOrEmpty(uiBlockedEmulator))
            {
                lblPollStats.Text = uiBlockedEmulator + " running — close to test";
                lblPollStats.ForeColor = isDarkMode ? Color.FromArgb(251, 191, 36) : Color.FromArgb(217, 119, 6);
            }
            else if (!string.IsNullOrEmpty(blocked))
            {
                lblPollStats.Text = "Adapter busy";
                lblPollStats.ForeColor = isDarkMode ? Color.FromArgb(251, 191, 36) : Color.FromArgb(217, 119, 6);
            }
            else
            {
                lblPollStats.Text = "No controller connected";
                lblPollStats.ForeColor = isDarkMode ? Color.FromArgb(148, 163, 184) : Color.FromArgb(100, 116, 139);
            }

            ushort btns = isConn ? selState.Gamepad.wButtons : (ushort)0;
            StringBuilder pressed = new StringBuilder();
            for (int i = 0; i < btnIndicators.Length; i++)
            {
                bool active = isConn && ((btns & btnMasks[i]) != 0);
                Label ind = btnIndicators[i];
                if (active)
                {
                    if (pressed.Length > 0) pressed.Append(", ");
                    pressed.Append(ind.Text);
                    if (i == 0) ind.BackColor = Color.FromArgb(16, 185, 129);
                    else if (i == 1) ind.BackColor = Color.FromArgb(220, 38, 38);
                    else if (i == 4) ind.BackColor = Color.FromArgb(124, 58, 237);
                    else ind.BackColor = Color.FromArgb(79, 70, 229);
                    ind.ForeColor = Color.White;
                }
                else
                {
                    ind.BackColor = isDarkMode ? Color.FromArgb(15, 23, 42) : Color.FromArgb(241, 245, 249);
                    ind.ForeColor = isDarkMode ? Color.FromArgb(148, 163, 184) : Color.FromArgb(71, 85, 105);
                }
            }

            if (isConn)
            {
                btnCloseEmu.Visible = false;
                lblPadHint.Size = new Size(312, 34);
                lblPadHint.ForeColor = isDarkMode ? Color.FromArgb(203, 213, 225) : Color.FromArgb(71, 85, 105);
                if (pressed.Length > 0)
                {
                    lblPadHint.Text = "Port " + (selectedPort + 1) + " Active: " + pressed.ToString();
                }
                else if (directMode && ReadBridgeStatus().StartsWith("NO_VIGEM"))
                {
                    lblPadHint.Text = "Port " + (selectedPort + 1) + " Connected (Direct USB) — Restart PC or Reinstall so Steam detects XInput.";
                }
                else if (directMode && !hasRumblePwr)
                {
                    lblPadHint.Text = "Port " + (selectedPort + 1) + " Connected (Direct WUP-028) — Plug Gray 5V USB for rumble.";
                }
                else
                {
                    int xSlotNum = allXSlots[selectedPort] + 1;
                    string bStatLive = ReadBridgeStatus();
                    bool isLegacyHid = bStatLive.IndexOf("src=LEGACY", StringComparison.OrdinalIgnoreCase) >= 0;
                    bool isHairTrig = bStatLive.IndexOf("trig=hair-trigger", StringComparison.OrdinalIgnoreCase) >= 0;
                    string modeLabel = directMode
                        ? "Direct WUP-028"
                        : (isLegacyHid
                            ? "PC Mode HID -> XInput"
                            : (xSlotNum == (selectedPort + 1) ? "WUP-028 -> XInput" : "WUP-028 -> XInput Slot " + xSlotNum));
                    string trigNote = isHairTrig ? " [Hair-Trigger Digital]" : "";
                    lblPadHint.Text = "Physical Port " + (selectedPort + 1) + " (" + modeLabel + ")" + trigNote + " — Test buttons, triggers & rumble.";
                }
            }
            else if (!string.IsNullOrEmpty(uiBlockedEmulator))
            {
                string shortName = uiBlockedEmulator.Length > 10 ? uiBlockedEmulator.Substring(0, 10) : uiBlockedEmulator;
                lblPadHint.Size = new Size(200, 34);
                lblPadHint.ForeColor = isDarkMode ? Color.FromArgb(253, 230, 138) : Color.FromArgb(146, 64, 14);
                if (!closingEmu)
                {
                    lblPadHint.Text = uiBlockedEmulator + " is running. Close it to test controllers.";
                    btnCloseEmu.Text = "Close " + shortName;
                    btnCloseEmu.Enabled = true;
                }
                btnCloseEmu.Visible = true;
            }
            else if (!string.IsNullOrEmpty(blocked))
            {
                btnCloseEmu.Visible = false;
                lblPadHint.Size = new Size(312, 34);
                lblPadHint.ForeColor = isDarkMode ? Color.FromArgb(253, 230, 138) : Color.FromArgb(146, 64, 14);
                lblPadHint.Text = blocked;
            }
            else
            {
                btnCloseEmu.Visible = false;
                lblPadHint.Size = new Size(312, 34);
                lblPadHint.ForeColor = isDarkMode ? Color.FromArgb(203, 213, 225) : Color.FromArgb(71, 85, 105);
                lblPadHint.Text = "Waiting for controllers on Ports 1-4. Plug into Mayflash W012 (Wii U / NS) and press any button.";
            }

            int lt = isConn ? selState.Gamepad.bLeftTrigger : 0;
            int rt = isConn ? selState.Gamepad.bRightTrigger : 0;
            bool lFull = isConn && lt >= 250;
            bool rFull = isConn && rt >= 250;
            int lPct = (int)Math.Round(lt * 100.0 / 255.0);
            int rPct = (int)Math.Round(rt * 100.0 / 255.0);

            lblLTrig.Text = "L Trigger: " + lt.ToString("D3") + " (" + lPct + "%)";
            lblRTrig.Text = "R Trigger: " + rt.ToString("D3") + " (" + rPct + "%)";

            if (lt != uiLeftTrig || lFull != uiLClick)
            {
                uiLeftTrig = lt;
                uiLClick = lFull;
                barLTrig.Invalidate();
            }
            if (rt != uiRightTrig || rFull != uiRClick)
            {
                uiRightTrig = rt;
                uiRClick = rFull;
                barRTrig.Invalidate();
            }

            short lx = isConn ? selState.Gamepad.sThumbLX : (short)0;
            short ly = isConn ? selState.Gamepad.sThumbLY : (short)0;
            short rx = isConn ? selState.Gamepad.sThumbRX : (short)0;
            short ry = isConn ? selState.Gamepad.sThumbRY : (short)0;
            if (lx != uiLX || ly != uiLY || rx != uiRX || ry != uiRY)
            {
                uiLX = lx;
                uiLY = ly;
                uiRX = rx;
                uiRY = ry;
                stickCanvas.Invalidate();
            }

            btnRumblePulse.Enabled = isConn;
            btnRumbleLeft.Enabled = isConn;
            btnRumbleRight.Enabled = isConn;
            btnRumbleStop.Enabled = isConn || activeLeftMotor > 0 || activeRightMotor > 0;

            int activeTesterPorts = 0;
            for (int i = 0; i < 4; i++)
            {
                if (conn[i]) activeTesterPorts++;
            }
            SyncLiveConnectionStatus(true, activeTesterPorts, directMode);
        }

        private void PaintSticks(object sender, PaintEventArgs e)
        {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            Color bg = isDarkMode ? Color.FromArgb(30, 41, 59) : Color.White;
            Color ringBg = isDarkMode ? Color.FromArgb(15, 23, 42) : Color.FromArgb(248, 250, 252);
            Color ringBorder = isDarkMode ? Color.FromArgb(71, 85, 105) : Color.FromArgb(203, 213, 225);
            Color cross = isDarkMode ? Color.FromArgb(51, 65, 85) : Color.FromArgb(226, 232, 240);
            Color lblCol = isDarkMode ? Color.FromArgb(148, 163, 184) : Color.FromArgb(100, 116, 139);

            g.Clear(bg);
            DrawOneStick(g, 38, 38, 30, uiLX, uiLY, "Main Stick", ringBg, ringBorder, cross, lblCol,
                uiHasSelectedPad ? Color.FromArgb(99, 102, 241) : Color.FromArgb(148, 163, 184));
            DrawOneStick(g, 116, 38, 30, uiRX, uiRY, "C-Stick", ringBg, ringBorder, cross, lblCol,
                uiHasSelectedPad ? Color.FromArgb(245, 158, 11) : Color.FromArgb(148, 163, 184));
        }

        private void DrawOneStick(Graphics g, int cx, int cy, int radius, short sx, short sy, string caption,
            Color ringBg, Color ringBorder, Color cross, Color lblCol, Color dotColor)
        {
            Rectangle circle = new Rectangle(cx - radius, cy - radius, radius * 2, radius * 2);
            using (SolidBrush br = new SolidBrush(ringBg))
            {
                g.FillEllipse(br, circle);
            }
            using (Pen pCross = new Pen(cross, 1F))
            {
                g.DrawLine(pCross, cx - radius + 3, cy, cx + radius - 3, cy);
                g.DrawLine(pCross, cx, cy - radius + 3, cx, cy + radius - 3);
            }
            using (Pen pRing = new Pen(ringBorder, 1.5F))
            {
                g.DrawEllipse(pRing, circle);
            }

            float nx = sx / 32768.0F;
            float ny = -sy / 32768.0F;
            float mag = (float)Math.Sqrt(nx * nx + ny * ny);
            if (mag > 1.0F)
            {
                nx /= mag;
                ny /= mag;
            }
            float dx = cx + (nx * (radius - 6));
            float dy = cy + (ny * (radius - 6));

            using (SolidBrush dotBr = new SolidBrush(dotColor))
            {
                g.FillEllipse(dotBr, dx - 5F, dy - 5F, 10F, 10F);
            }
            using (SolidBrush txtBr = new SolidBrush(lblCol))
            using (Font f = new Font("Segoe UI", 7.25F, FontStyle.Bold))
            {
                SizeF sz = g.MeasureString(caption, f);
                g.DrawString(caption, f, txtBr, cx - (sz.Width / 2F), cy + radius + 5);
            }
        }

        private void PaintTriggerBar(Graphics g, Rectangle rect, int val, bool clicked)
        {
            Color trackBg = isDarkMode ? Color.FromArgb(15, 23, 42) : Color.FromArgb(241, 245, 249);
            Color borderCol = clicked
                ? Color.FromArgb(16, 185, 129)
                : (isDarkMode ? Color.FromArgb(71, 85, 105) : Color.FromArgb(203, 213, 225));
            Color fillCol = clicked
                ? Color.FromArgb(16, 185, 129)
                : (isDarkMode ? Color.FromArgb(99, 102, 241) : Color.FromArgb(79, 70, 229));

            using (SolidBrush br = new SolidBrush(trackBg))
            {
                g.FillRectangle(br, rect);
            }
            int fillW = (int)Math.Round(((rect.Width - 2) * val) / 255.0);
            if (fillW > 0)
            {
                using (SolidBrush fbr = new SolidBrush(fillCol))
                {
                    g.FillRectangle(fbr, 1, 1, fillW, rect.Height - 2);
                }
            }
            using (Pen pen = new Pen(borderCol, 1F))
            {
                g.DrawRectangle(pen, 0, 0, rect.Width - 1, rect.Height - 1);
            }
        }

