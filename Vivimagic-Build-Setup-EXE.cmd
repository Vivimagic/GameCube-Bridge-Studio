            sb.Append("    \"rumblePwmHz\": ").Append(GetSelectedPwmHz()).Append(",").Append(nl);
            sb.Append("    \"snapbackFilterMs\": ").Append((int)numFwSnapback.Value).Append(",").Append(nl);
            sb.Append("    \"recoveryCombo\": \"").Append(GetFwRecoveryKey()).Append("\",").Append(nl);
            sb.Append("    \"enableHardwareLedStatus\": ").Append(chkFwLed.Checked ? "true" : "false").Append(nl);
            sb.Append("  },").Append(nl);
            sb.Append("  \"calibration\": {").Append(nl);
            sb.Append("    \"profileName\": \"Mayflash W012 — Modern XInput + Rumble\",").Append(nl);
            sb.Append("    \"faceLayout\": \"xbox-spatial\",").Append(nl);
            sb.Append("    \"useNintendoButtonLayout\": false,").Append(nl);
            sb.Append("    \"zMapping\": \"rb\",").Append(nl);
            sb.Append("    \"startPlusDpadUpIsBack\": true,").Append(nl);
            sb.Append("    \"swapTriggersToBumpers\": false,").Append(nl);
            sb.Append("    \"mainStickDeadzone\": 0.100,").Append(nl);
            sb.Append("    \"mainStickRangeScale\": 1.12,").Append(nl);
            sb.Append("    \"cStickDeadzone\": 0.120,").Append(nl);
            sb.Append("    \"cStickRangeScale\": 1.15,").Append(nl);
            sb.Append("    \"triggerMode\": \"analog-only\",").Append(nl);
            sb.Append("    \"triggerThreshold\": 175,").Append(nl);
            sb.Append("    \"rumbleEnabled\": true,").Append(nl);
            sb.Append("    \"rumbleMinThreshold\": 12,").Append(nl);
            sb.Append("    \"rumblePwmModulation\": true,").Append(nl);
            sb.Append("    \"rumbleStrengthScale\": 100,").Append(nl);
            sb.Append("    \"autoYieldToEmulators\": true").Append(nl);
            sb.Append("  }").Append(nl);
            sb.Append("}").Append(nl);
            return sb.ToString();
        }

        private string GetSdkContentByIndex(int idx)
        {
            if (idx == 1) return BuildOpenGcSourceC();
            if (idx == 2) return BuildCommunityPresetJson();
            return BuildOpenGcHeader();
        }

        private void RefreshFirmwareSdkCode()
        {
            if (txtFwSdkCode == null || cmbFwSdkFile == null) return;
            txtFwSdkCode.Text = GetSdkContentByIndex(cmbFwSdkFile.SelectedIndex);
        }

        private void SaveFirmwareFile(int idx)
        {
            string safeName = Regex.Replace(txtFwName.Text.Trim(), @"[^a-zA-Z0-9_-]", "_");
            if (string.IsNullOrEmpty(safeName)) safeName = "OpenGC_Custom";
            string defaultName = idx == 0 ? "opengc_config.h" : (idx == 1 ? "opengc_xinput_firmware.c" : safeName + ".opengc.json");
            string filter = idx == 0 ? "C Header (*.h)|*.h|All Files (*.*)|*.*" : (idx == 1 ? "C Source (*.c)|*.c|All Files (*.*)|*.*" : "OpenGC Preset (*.json)|*.json|All Files (*.*)|*.*");
            using (SaveFileDialog sfd = new SaveFileDialog())
            {
                sfd.FileName = defaultName;
                sfd.Filter = filter;
                if (sfd.ShowDialog(this) == DialogResult.OK)
                {
                    try
                    {
                        File.WriteAllText(sfd.FileName, GetSdkContentByIndex(idx), Encoding.UTF8);
                        string msg = "Saved " + Path.GetFileName(sfd.FileName);
                        lblFwSdkHint.Text = msg;
                        lblFwConfigHint.Text = msg;
                    }
                    catch (Exception ex)
                    {
                        lblFwSdkHint.Text = "Save failed: " + ex.Message;
                        lblFwConfigHint.Text = "Save failed: " + ex.Message;
                    }
                }
            }
        }

        private static string ExtractJsonString(string json, string key)
        {
            Match m = Regex.Match(json, "\"" + Regex.Escape(key) + "\"\\s*:\\s*\"([^\"]*)\"");
            return m.Success ? m.Groups[1].Value : null;
        }

        private static int ExtractJsonInt(string json, string key, int fallback)
        {
            Match m = Regex.Match(json, "\"" + Regex.Escape(key) + "\"\\s*:\\s*(\\d+)");
            int val;
            return (m.Success && int.TryParse(m.Groups[1].Value, out val)) ? val : fallback;
        }

        private static bool ExtractJsonBool(string json, string key, bool fallback)
        {
            Match m = Regex.Match(json, "\"" + Regex.Escape(key) + "\"\\s*:\\s*(true|false)");
            return m.Success ? (m.Groups[1].Value == "true") : fallback;
        }

        private void ImportFirmwarePresetJson()
        {
            using (OpenFileDialog ofd = new OpenFileDialog())
            {
                ofd.Filter = "OpenGC Community Preset (*.json)|*.json|All Files (*.*)|*.*";
                if (ofd.ShowDialog(this) != DialogResult.OK) return;
                try
                {
                    string json = File.ReadAllText(ofd.FileName, Encoding.UTF8);
                    if (json.IndexOf("opengc-firmware-preset/v1", StringComparison.OrdinalIgnoreCase) < 0)
                    {
                        lblFwConfigHint.Text = "Unrecognized file: expected opengc-firmware-preset/v1 JSON.";
                        return;
                    }
                    suppressFwEvents = true;
                    try
                    {
                        string name = ExtractJsonString(json, "firmwareName");
                        string author = ExtractJsonString(json, "authorHandle");
                        string ver = ExtractJsonString(json, "version");
                        string target = ExtractJsonString(json, "targetPlatform");
                        string pers = ExtractJsonString(json, "usbPersonality");
                        string rec = ExtractJsonString(json, "recoveryCombo");
                        int poll = ExtractJsonInt(json, "pollingRateHz", 1000);
                        int pwm = ExtractJsonInt(json, "rumblePwmHz", 120);
                        int snap = ExtractJsonInt(json, "snapbackFilterMs", 6);
                        bool led = ExtractJsonBool(json, "enableHardwareLedStatus", true);

                        if (!string.IsNullOrEmpty(name)) txtFwName.Text = name;
                        if (!string.IsNullOrEmpty(author)) txtFwAuthor.Text = author;
                        if (!string.IsNullOrEmpty(ver)) txtFwVersion.Text = ver;
                        cmbFwTarget.SelectedIndex = (target == "rp2040-direct-joybus") ? 1 : 0;
                        cmbFwPersonality.SelectedIndex = (pers == "dual-xinput-wup028") ? 1 : 0;
                        cmbFwPollHz.SelectedIndex = (poll == 125 ? 0 : (poll == 250 ? 1 : (poll == 500 ? 2 : 3)));
                        cmbFwPwmHz.SelectedIndex = (pwm == 60 ? 0 : (pwm == 200 ? 2 : 1));
                        cmbFwRecovery.SelectedIndex = (rec == "l+r+start") ? 1 : 0;
                        if (snap < 0) snap = 0;
                        if (snap > 24) snap = 24;
                        numFwSnapback.Value = snap;
                        chkFwLed.Checked = led;
                    }
                    finally
                    {
                        suppressFwEvents = false;
                    }
                    lblFwConfigHint.Text = "Imported " + Path.GetFileName(ofd.FileName) + " successfully.";
                    RefreshFirmwareSdkCode();
                }
                catch (Exception ex)
                {
                    lblFwConfigHint.Text = "Import failed: " + ex.Message;
                }
            }
        }

        private void InspectLocalFirmwareFile()
        {
            using (OpenFileDialog ofd = new OpenFileDialog())
            {
                ofd.Filter = "Firmware Images (*.exe;*.bin;*.uf2)|*.exe;*.bin;*.uf2|All Files (*.*)|*.*";
                if (ofd.ShowDialog(this) != DialogResult.OK) return;
                try
                {
                    byte[] data = File.ReadAllBytes(ofd.FileName);
                    AnalyzeAndDisplayFirmwareBytes(data, Path.GetFileName(ofd.FileName));
                }
                catch (Exception ex)
                {
                    txtFwInspectResult.Text = "Could not read file: " + ex.Message;
                }
            }
        }

        private void InspectSampleW012Binary()
        {
            int size = 65600;
            byte[] sample = new byte[size];
            uint seed = 0x1337C0DEu;
            for (int i = 0; i < size; i++)
            {
                seed = unchecked(seed * 1664525u + 1013904223u);
                sample[i] = (byte)(seed >> 24);
            }
            string tag = "MAYFLASH W012 HJM2130A V1.04 ";
            for (int i = 0; i < tag.Length; i++)
            {
                sample[i] = (byte)(tag[i] ^ 0xCB);
            }
            AnalyzeAndDisplayFirmwareBytes(sample, "Sample_W012_V1.04_Structure.bin");
        }

        private void AnalyzeAndDisplayFirmwareBytes(byte[] data, string filename)
        {
            int len = data.Length;
            string sha256 = "";
            using (SHA256 sha = SHA256.Create())
            {
                byte[] hash = sha.ComputeHash(data);
                StringBuilder hsb = new StringBuilder(64);
                for (int i = 0; i < hash.Length; i++) hsb.Append(hash[i].ToString("x2"));
                sha256 = hsb.ToString();
            }

            int[] counts = new int[256];
            for (int i = 0; i < len; i++) counts[data[i]]++;
            double entropy = 0.0;
            if (len > 0)
            {
                for (int i = 0; i < 256; i++)
                {
                    if (counts[i] == 0) continue;
                    double p = (double)counts[i] / len;
                    entropy -= p * (Math.Log(p) / Math.Log(2.0));
                }
            }

            int scanLimit = Math.Min(len, 512000);
            StringBuilder rawAscii = new StringBuilder(scanLimit);
            StringBuilder xorAscii = new StringBuilder(scanLimit);
            int xorRuns = 0;
            int curRun = 0;
            for (int i = 0; i < scanLimit; i++)
            {
                byte b = data[i];
                rawAscii.Append((b >= 32 && b <= 126) ? (char)b : ' ');
                byte xb = (byte)(b ^ 0xCB);
                if (xb >= 32 && xb <= 126)
                {
                    xorAscii.Append((char)xb);
                    curRun++;
                    if (curRun == 8) xorRuns++;
                }
                else
                {
                    xorAscii.Append(' ');
                    curRun = 0;
                }
            }

            string combined = rawAscii.ToString() + " " + xorAscii.ToString();
            MatchCollection matches = Regex.Matches(combined, @"\b(?:W012|HJM2130A|V\d+\.\d+|V0[5-9]|V1[0-9])\b", RegexOptions.IgnoreCase);
            List<string> markers = new List<string>();
            for (int i = 0; i < matches.Count && markers.Count < 8; i++)
            {
                string val = matches[i].Value.ToUpperInvariant();
                if (!markers.Contains(val)) markers.Add(val);
            }

            bool isUf2 = len >= 8 && data[0] == 0x55 && data[1] == 0x46 && data[2] == 0x32 && data[3] == 0x0A;
            int estBlocks = Math.Max(1, (int)Math.Round(len / 32800.0));
            bool looksOfficial = (entropy >= 7.6);
            if (!looksOfficial)
            {
                for (int i = 0; i < markers.Count; i++)
                {
                    if (markers[i].Contains("W012") || markers[i].Contains("HJM") || markers[i].StartsWith("V1."))
                    {
                        looksOfficial = true;
                        break;
                    }
                }
            }

            string verdictTitle;
            string verdictDetail;
            if (isUf2)
            {
                verdictTitle = "[SAFE - REVERSIBLE RP2040 UF2] OpenGC UF2 Firmware Image";
                verdictDetail = "Valid UF2 magic header (0x0A324655) detected. Safe to drag-and-drop onto an RP2040 USB bridge board and revert anytime via UF2 bootloader.";
            }
            else if (looksOfficial)
            {
                verdictTitle = "[HIGH-ENTROPY ENCRYPTED W012] Official Mayflash Container Detected";
                verdictDetail = "Shannon entropy >= 7.6 bits/byte or HJM2130A/W012 markers detected. Only official Mayflash signed packages should ever be flashed to stock W012 hardware.";
            }
            else
            {
                verdictTitle = "[DANGER - UNVERIFIED BINARY] Do Not Flash To Stock W012";
                verdictDetail = "Does not match a UF2 open container or recognized Mayflash encrypted package. Flashing to stock HJM2130A hardware risks a permanent hard-brick.";
            }

            string nl = Environment.NewLine;
            StringBuilder outSb = new StringBuilder();
            outSb.Append(verdictTitle).Append(nl);
            outSb.Append(verdictDetail).Append(nl).Append(nl);
            outSb.Append("File          : ").Append(filename).Append(nl);
            outSb.Append("Size          : ").Append(len.ToString("N0")).Append(" bytes (~").Append(estBlocks).Append(" blocks)").Append(nl);
            outSb.Append("Entropy       : ").Append(entropy.ToString("F4")).Append(" bits/byte (max 8.0000)").Append(nl);
            outSb.Append("Markers       : ").Append(markers.Count > 0 ? string.Join(" | ", markers.ToArray()) : "None detected").Append(nl);
            outSb.Append("0xCB Runs     : ").Append(xorRuns).Append(" printable runs").Append(nl);
            outSb.Append("SHA-256       : ").Append(sha256);
            txtFwInspectResult.Text = outSb.ToString();
        }

