        private void UpdateWindowHeight()
        {
            if (firmwareVisible)
            {
                ClientSize = new Size(540, 668);
            }
            else if (testerVisible)
            {
                ClientSize = new Size(540, 602);
            }
            else if (detailsVisible)
            {
                ClientSize = new Size(540, 500);
            }
            else
            {
                ClientSize = new Size(540, 360);
            }
        }

        private void SetTesterVisible(bool show)
        {
            testerVisible = show;
            if (testerVisible)
            {
                detailsVisible = false;
                firmwareVisible = false;
                txtLog.Visible = false;
                firmwareBorder.Visible = false;
                btnDetails.Text = "Show Details";
                btnFirmware.Text = "Firmware & SDK";
                StartPolling();
                RefreshTesterUi();
            }
            else
            {
                StopAllRumble();
                StopPolling();
            }
            testerBorder.Visible = testerVisible;
            btnTester.Text = testerVisible ? "Hide Pad" : "Test Pad";
            ApplyTheme();
            UpdateWindowHeight();
        }

        private void ToggleTester()
        {
            SetTesterVisible(!testerVisible);
        }

        private void SetFirmwareVisible(bool show)
        {
            firmwareVisible = show;
            if (firmwareVisible)
            {
                detailsVisible = false;
                txtLog.Visible = false;
                btnDetails.Text = "Show Details";
                if (testerVisible)
                {
                    testerVisible = false;
                    testerBorder.Visible = false;
                    btnTester.Text = "Test Pad";
                    StopAllRumble();
                    StopPolling();
                }
                if (firmwareUnlocked)
                {
                    RefreshFirmwareSdkCode();
                }
            }
            firmwareBorder.Visible = firmwareVisible;
            btnFirmware.Text = firmwareVisible ? "Hide SDK" : "Firmware & SDK";
            ApplyTheme();
            UpdateWindowHeight();
        }

        private void ToggleFirmware()
        {
            SetFirmwareVisible(!firmwareVisible);
        }

        private void ToggleDetails()
        {
            detailsVisible = !detailsVisible;
            if (detailsVisible)
            {
                firmwareVisible = false;
                firmwareBorder.Visible = false;
                btnFirmware.Text = "Firmware & SDK";
                if (testerVisible)
                {
                    testerVisible = false;
                    testerBorder.Visible = false;
                    btnTester.Text = "Test Pad";
                    StopAllRumble();
                    StopPolling();
                }
            }
            txtLog.Visible = detailsVisible;
            btnDetails.Text = detailsVisible ? "Hide Details" : "Show Details";
            ApplyTheme();
            UpdateWindowHeight();
        }

        private void OpenSettingsDialog()
        {
            btnSettings.Active = true;
            try
            {
                using (SettingsDialog dlg = new SettingsDialog(
                    isDarkMode,
                    Icon,
                    delegate(bool dark)
                    {
                        isDarkMode = dark;
                        ApplyTheme();
                    },
                    delegate
                    {
                        Close();
                    }))
                {
                    dlg.ShowDialog(this);
                }
            }
            finally
            {
                btnSettings.Active = false;
            }
