        private static void TryAddGuid(List<Guid> list, string raw)
        {
            if (string.IsNullOrEmpty(raw)) return;
            string s = raw.Trim();
            if (s.Length < 32) return;
            try
            {
                Guid g = new Guid(s);
                if (!list.Contains(g)) list.Add(g);
            }
            catch { }
        }

        private static List<Guid> CollectCandidateGuids()
        {
            List<Guid> guids = new List<Guid>();
            IntPtr hDevInfo = SetupDiGetClassDevs(IntPtr.Zero, "USB", IntPtr.Zero, DIGCF_ALLCLASSES | DIGCF_PRESENT);
            if (hDevInfo != IntPtr.Zero && hDevInfo != new IntPtr(-1))
            {
                try
                {
                    uint idx = 0;
                    while (true)
                    {
                        SP_DEVINFO_DATA devData = new SP_DEVINFO_DATA();
                        devData.cbSize = (uint)Marshal.SizeOf(typeof(SP_DEVINFO_DATA));
                        if (!SetupDiEnumDeviceInfo(hDevInfo, idx, ref devData)) break;
                        idx++;

                        StringBuilder idBuf = new StringBuilder(512);
                        uint req;
                        if (!SetupDiGetDeviceInstanceId(hDevInfo, ref devData, idBuf, (uint)idBuf.Capacity, out req)) continue;
                        string instId = idBuf.ToString();
                        if (instId.IndexOf("VID_057E", StringComparison.OrdinalIgnoreCase) < 0 ||
                            instId.IndexOf("PID_0337", StringComparison.OrdinalIgnoreCase) < 0)
                        {
                            continue;
                        }

                        IntPtr hKey = SetupDiOpenDevRegKey(hDevInfo, ref devData, DICS_FLAG_GLOBAL, 0, DIREG_DEV, KEY_READ);
                        if (hKey != IntPtr.Zero && hKey != new IntPtr(-1))
                        {
                            try
                            {
                                string[] valNames = new string[] { "DeviceInterfaceGUIDs", "DeviceInterfaceGUID" };
                                for (int v = 0; v < valNames.Length; v++)
                                {
                                    uint regType;
                                    uint size = 0;
                                    if (RegQueryValueEx(hKey, valNames[v], IntPtr.Zero, out regType, null, ref size) == 0 && size > 0 && size < 8192)
                                    {
                                        byte[] data = new byte[size];
                                        if (RegQueryValueEx(hKey, valNames[v], IntPtr.Zero, out regType, data, ref size) == 0)
                                        {
                                            string decoded = Encoding.Unicode.GetString(data);
                                            string[] parts = decoded.Split(new char[] { (char)0 }, StringSplitOptions.RemoveEmptyEntries);
                                            for (int k = 0; k < parts.Length; k++)
                                            {
                                                TryAddGuid(guids, parts[k]);
                                            }
                                        }
                                    }
                                }
                            }
                            finally
                            {
                                RegCloseKey(hKey);
                            }
                        }
                    }
                }
                finally
                {
                    SetupDiDestroyDeviceInfoList(hDevInfo);
                }
            }

            TryAddGuid(guids, "{C6E9F5A2-4B7D-4D89-9E12-57E033700012}");
            TryAddGuid(guids, "{DEE824EF-729B-4A0E-9C14-B7117D33A817}");
            TryAddGuid(guids, "{A5DCBF10-6530-11D2-901F-00C04FB951ED}");
            return guids;
        }

        public static string FindDevicePath()
        {
            List<Guid> guids = CollectCandidateGuids();
            string fallbackPath = null;
            for (int gIdx = 0; gIdx < guids.Count; gIdx++)
            {
                Guid g = guids[gIdx];
                IntPtr hSet = SetupDiGetClassDevs(ref g, null, IntPtr.Zero, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
                if (hSet == IntPtr.Zero || hSet == new IntPtr(-1)) continue;
                try
                {
                    uint mIdx = 0;
                    while (true)
                    {
                        SP_DEVICE_INTERFACE_DATA ifData = new SP_DEVICE_INTERFACE_DATA();
                        ifData.cbSize = (uint)Marshal.SizeOf(typeof(SP_DEVICE_INTERFACE_DATA));
                        if (!SetupDiEnumDeviceInterfaces(hSet, IntPtr.Zero, ref g, mIdx, ref ifData)) break;
                        mIdx++;

                        uint reqSize = 0;
                        SetupDiGetDeviceInterfaceDetail(hSet, ref ifData, IntPtr.Zero, 0, out reqSize, IntPtr.Zero);
                        if (reqSize < 8 || reqSize > 4096) continue;

                        IntPtr detailBuf = Marshal.AllocHGlobal((int)reqSize);
                        try
                        {
                            Marshal.WriteInt32(detailBuf, IntPtr.Size == 8 ? 8 : 6);
                            uint ignored;
                            if (SetupDiGetDeviceInterfaceDetail(hSet, ref ifData, detailBuf, reqSize, out ignored, IntPtr.Zero))
                            {
                                string devPath = Marshal.PtrToStringUni(new IntPtr(detailBuf.ToInt64() + 4));
                                if (!string.IsNullOrEmpty(devPath) &&
                                    devPath.IndexOf("vid_057e", StringComparison.OrdinalIgnoreCase) >= 0 &&
                                    devPath.IndexOf("pid_0337", StringComparison.OrdinalIgnoreCase) >= 0)
                                {
                                    if (devPath.IndexOf("mi_00", StringComparison.OrdinalIgnoreCase) >= 0)
                                    {
                                        return devPath;
                                    }
                                    if (fallbackPath == null)
                                    {
                                        fallbackPath = devPath;
                                    }
                                }
                            }
                        }
                        finally
                        {
                            Marshal.FreeHGlobal(detailBuf);
                        }
                    }
                }
                finally
                {
                    SetupDiDestroyDeviceInfoList(hSet);
                }
            }
            return fallbackPath;
        }

        public bool Open(out int win32Err)
        {
            lock (ioLock)
            {
                win32Err = 0;
                if (winUsbHandle != IntPtr.Zero) return true;

                string path = FindDevicePath();
                if (string.IsNullOrEmpty(path))
                {
                    win32Err = 1167;
                    return false;
                }

                IntPtr hFile = CreateFile(path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, IntPtr.Zero, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, IntPtr.Zero);
                if (hFile == IntPtr.Zero || hFile == new IntPtr(-1))
                {
                    win32Err = Marshal.GetLastWin32Error();
                    return false;
                }

                IntPtr hWinUsb;
                if (!WinUsb_Initialize(hFile, out hWinUsb))
                {
                    win32Err = Marshal.GetLastWin32Error();
                    CloseHandle(hFile);
                    return false;
                }

                fileHandle = hFile;
                winUsbHandle = hWinUsb;
                inPipe = 0x81;
                outPipe = 0x02;

                try
                {
                    USB_INTERFACE_DESCRIPTOR desc;
                    if (WinUsb_QueryInterfaceSettings(winUsbHandle, 0, out desc))
                    {
                        bool foundInterruptIn = false;
                        bool foundInterruptOut = false;
                        for (byte i = 0; i < desc.bNumEndpoints; i++)
                        {
                            WINUSB_PIPE_INFORMATION pipe;
                            if (WinUsb_QueryPipe(winUsbHandle, 0, i, out pipe))
                            {
                                bool isInterrupt = (pipe.PipeType == 3);
                                if ((pipe.PipeId & 0x80) != 0)
                                {
                                    if (isInterrupt || !foundInterruptIn)
                                    {
                                        inPipe = pipe.PipeId;
                                        if (isInterrupt) foundInterruptIn = true;
                                    }
                                }
                                else
                                {
                                    if (isInterrupt || !foundInterruptOut)
                                    {
                                        outPipe = pipe.PipeId;
                                        if (isInterrupt) foundInterruptOut = true;
                                    }
                                }
                            }
                        }
                    }
                }
                catch { }

                uint timeoutMs = 60;
                WinUsb_SetPipePolicy(winUsbHandle, inPipe, PIPE_TRANSFER_TIMEOUT, 4, ref timeoutMs);
                WinUsb_SetPipePolicy(winUsbHandle, outPipe, PIPE_TRANSFER_TIMEOUT, 4, ref timeoutMs);

                // Match v1 init sequence directly (0x13) for Official Nintendo WUP-028 & Mayflash W012
                byte[] initCmd = new byte[] { 0x13 };
                uint written;
                WinUsb_WritePipe(winUsbHandle, outPipe, initCmd, 1, out written, IntPtr.Zero);
                return true;
            }
        }

        public bool ReadReport(byte[] buf37, out int win32Err)
        {
            win32Err = 0;
            IntPtr h = winUsbHandle;
            if (h == IntPtr.Zero)
            {
                win32Err = 6;
                return false;
            }
            uint transferred = 0;
            bool ok = WinUsb_ReadPipe(h, inPipe, buf37, 37, out transferred, IntPtr.Zero);
            if (!ok)
            {
                win32Err = Marshal.GetLastWin32Error();
                return false;
            }
            return transferred >= 37 && buf37[0] == 0x21;
        }

        public bool SendRumble(bool p0, bool p1, bool p2, bool p3)
        {
            lock (ioLock)
            {
                if (winUsbHandle == IntPtr.Zero) return false;
                byte[] cmd = new byte[] { 0x11, (byte)(p0 ? 1 : 0), (byte)(p1 ? 1 : 0), (byte)(p2 ? 1 : 0), (byte)(p3 ? 1 : 0) };
                uint written;
                return WinUsb_WritePipe(winUsbHandle, outPipe, cmd, 5, out written, IntPtr.Zero);
            }
        }

        public void Close()
        {
            lock (ioLock)
            {
                if (winUsbHandle != IntPtr.Zero)
                {
                    try
                    {
                        byte[] off = new byte[] { 0x11, 0, 0, 0, 0 };
                        uint w;
                        WinUsb_WritePipe(winUsbHandle, outPipe, off, 5, out w, IntPtr.Zero);
                    }
                    catch { }
                    try { WinUsb_Free(winUsbHandle); } catch { }
                    winUsbHandle = IntPtr.Zero;
                }
                if (fileHandle != IntPtr.Zero && fileHandle != new IntPtr(-1))
                {
                    try { CloseHandle(fileHandle); } catch { }
                    fileHandle = IntPtr.Zero;
                }
            }
        }

        public void Dispose()
        {
            Close();
        }
    }

