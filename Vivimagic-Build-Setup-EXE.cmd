            lblFwConfigHint.Text = "Active build: " + txtFwName.Text + " v" + txtFwVersion.Text + " (" + GetSelectedPollHz() + " Hz, " + GetSelectedPwmHz() + " Hz PWM, Snapback " + ((int)numFwSnapback.Value) + " ms).";
