#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_NAME="Vivimagic GC Suite.app"
APP_DIR="$SCRIPT_DIR/$APP_NAME"
CONTENTS_DIR="$APP_DIR/Contents"
MACOS_DIR="$CONTENTS_DIR/MacOS"
RES_DIR="$CONTENTS_DIR/Resources"

echo "=============================================================="
echo "  Vivimagic - Building Native macOS GUI App Bundle"
echo "  Publisher: Vivimagic"
echo "=============================================================="

rm -rf "$APP_DIR"
mkdir -p "$MACOS_DIR" "$RES_DIR"

b64dec() {
  if printf '' | base64 --decode >/dev/null 2>&1; then
    base64 --decode
  else
    base64 -D
  fi
}

# Decode embedded Vivimagic SVG, 256px PNG icon, and calibration profile
cat <<'EOF_SVG' | b64dec > "$RES_DIR/vivimagic-w012-installer.svg"

EOF_SVG

cat <<'EOF_PROF' | b64dec > "$RES_DIR/mayflash-w012-profile.json"

EOF_PROF

cat <<'EOF_LIC' | b64dec > "$RES_DIR/LICENSE.txt"

EOF_LIC

cat <<'EOF_TESTER' | b64dec > "$RES_DIR/controller-tester.html"

EOF_TESTER

PNG_B64=""
if [ -n "$PNG_B64" ]; then
  printf '%s' "$PNG_B64" | b64dec > "$RES_DIR/vivimagic-icon.png"
  ICONSET_DIR="$(mktemp -d)/VivimagicIcon.iconset"
  mkdir -p "$ICONSET_DIR"
  sips -z 16 16     "$RES_DIR/vivimagic-icon.png" --out "$ICONSET_DIR/icon_16x16.png"      >/dev/null 2>&1 || true
  sips -z 32 32     "$RES_DIR/vivimagic-icon.png" --out "$ICONSET_DIR/icon_16x16@2x.png"   >/dev/null 2>&1 || true
  sips -z 32 32     "$RES_DIR/vivimagic-icon.png" --out "$ICONSET_DIR/icon_32x32.png"      >/dev/null 2>&1 || true
  sips -z 64 64     "$RES_DIR/vivimagic-icon.png" --out "$ICONSET_DIR/icon_32x32@2x.png"   >/dev/null 2>&1 || true
  sips -z 128 128   "$RES_DIR/vivimagic-icon.png" --out "$ICONSET_DIR/icon_128x128.png"    >/dev/null 2>&1 || true
  sips -z 256 256   "$RES_DIR/vivimagic-icon.png" --out "$ICONSET_DIR/icon_128x128@2x.png" >/dev/null 2>&1 || true
  sips -z 256 256   "$RES_DIR/vivimagic-icon.png" --out "$ICONSET_DIR/icon_256x256.png"    >/dev/null 2>&1 || true
  cp "$RES_DIR/vivimagic-icon.png" "$ICONSET_DIR/icon_256x256@2x.png" 2>/dev/null || true
  iconutil -c icns "$ICONSET_DIR" -o "$RES_DIR/VivimagicIcon.icns" >/dev/null 2>&1 || true
  rm -rf "$(dirname "$ICONSET_DIR")"
fi

cat <<'EOF_PLIST' > "$CONTENTS_DIR/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Vivimagic GC Suite</string>
  <key>CFBundleExecutable</key>
  <string>VivimagicSetup</string>
  <key>CFBundleIconFile</key>
  <string>VivimagicIcon</string>
  <key>CFBundleIdentifier</key>
  <string>com.vivimagic.mayflashw012.setup</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Vivimagic GC Suite</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>2.0.0</string>
  <key>CFBundleVersion</key>
  <string>2.0.0</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright (c) 2026 Ashley Glover. All Rights Reserved.</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
EOF_PLIST

cat <<'EOF_LAUNCHER' > "$MACOS_DIR/VivimagicSetup"
#!/bin/bash
set -euo pipefail

BUNDLE_RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
ICON_ICNS="$BUNDLE_RES/VivimagicIcon.icns"
INSTALL_ROOT="$HOME/Library/Application Support/Vivimagic/GCBridgeW012"
PLIST_PATH="$HOME/Library/LaunchAgents/com.vivimagic.gcbridgew012.plist"
YIELD_REGEX="Dolphin|SlippiDolphin|DolphinQt2|DolphinWx"
AUTO_YIELD="true"
HANDOVER_MODE="window-focus"

show_dialog() {
  local msg="$1"
  local buttons="$2"
  local default_btn="$3"
  if [ -f "$ICON_ICNS" ]; then
    osascript -e "button returned of (display dialog \"$msg\" with title \"Vivimagic GC Suite\" buttons {$buttons} default button \"$default_btn\" with icon POSIX file \"$ICON_ICNS\")" 2>/dev/null || echo "Cancel"
  else
    osascript -e "button returned of (display dialog \"$msg\" with title \"Vivimagic GC Suite\" buttons {$buttons} default button \"$default_btn\")" 2>/dev/null || echo "Cancel"
  fi
}

notify_mac() {
  osascript -e "display notification \"$1\" with title \"Vivimagic GC Suite\"" 2>/dev/null || true
}

check_updates_mac() {
  local latest=""
  latest="$(curl -fsSL -H 'User-Agent: VivimagicGCBridge/2.0.0' https://api.github.com/repos/Vivimagic/GameCube-Bridge-Studio/releases/latest 2>/dev/null | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1 || true)"
  if [ -z "$latest" ]; then
    open "https://github.com/Vivimagic/GameCube-Bridge-Studio/releases" >/dev/null 2>&1 || true
    return
  fi
  if [ "$latest" = "v2.0.0" ]; then
    notify_mac "You are running the latest version (v2.0.0)."
  else
    local upd_btn
    upd_btn="$(show_dialog "A new release ($latest) is available on GitHub (installed: v2.0.0).\n\nOpen the GitHub Releases page now?" "\"Later\", \"Open Releases\"" "Open Releases")"
    if [ "$upd_btn" = "Open Releases" ]; then
      open "https://github.com/Vivimagic/GameCube-Bridge-Studio/releases" >/dev/null 2>&1 || true
    fi
  fi
}

do_uninstall() {
  launchctl unload "$PLIST_PATH" >/dev/null 2>&1 || true
  rm -f "$PLIST_PATH"
  pkill -f "vivimagic-gcbridge-supervisor.sh" >/dev/null 2>&1 || true
  rm -rf "$INSTALL_ROOT"
}

do_install() {
  # Check USB switch state via ioreg (Mayflash 1846 / 1844 / 1843 legacy PC modes)
  if ioreg -p IOUSB -l 2>/dev/null | grep -qiE "0x1846|0x1844|0x1843"; then
    local sw_btn
    sw_btn="$(show_dialog "GameCube adapter detected in legacy PC mode (0079:1846/1844/1843).\n\nFor native 4-port Wii U / NS mode + rumble, flip the rear switch to Wii U / NS, plug BOTH Black (Data) and Gray (5V Rumble) USB connectors back in, and click Continue." "\"Cancel\", \"Continue\"" "Continue")"
    if [ "$sw_btn" != "Continue" ]; then
      exit 0
    fi
  fi

  mkdir -p "$INSTALL_ROOT/Profiles" "$HOME/Library/LaunchAgents"
  cp "$BUNDLE_RES/mayflash-w012-profile.json" "$INSTALL_ROOT/Profiles/mayflash-w012-profile.json"
  cp "$BUNDLE_RES/vivimagic-w012-installer.svg" "$INSTALL_ROOT/vivimagic-w012-installer.svg"
  if [ -f "$BUNDLE_RES/LICENSE.txt" ]; then
    cp "$BUNDLE_RES/LICENSE.txt" "$INSTALL_ROOT/LICENSE.txt"
  fi
  if [ -f "$BUNDLE_RES/controller-tester.html" ]; then
    cp "$BUNDLE_RES/controller-tester.html" "$INSTALL_ROOT/controller-tester.html"
  fi
  if [ -f "$BUNDLE_RES/vivimagic-icon.png" ]; then
    cp "$BUNDLE_RES/vivimagic-icon.png" "$INSTALL_ROOT/vivimagic-icon.png"
  fi

  # Write v2.0.0 Dolphin/Slippi-aware background supervisor (supports window-focus and process-running modes)
  cat <<'EOF_SUP' > "$INSTALL_ROOT/vivimagic-gcbridge-supervisor.sh"
#!/bin/bash
YIELD_REGEX="$1"
AUTO_YIELD="$2"
HANDOVER_MODE="${3:-window-focus}"
ADAPTER_BIN="$(command -v wiiu-gc-adapter || command -v wii-u-gc-adapter || true)"
if [ -z "$ADAPTER_BIN" ]; then
  exit 0
fi
while true; do
  EMU_ACTIVE=0
  if [ "$AUTO_YIELD" = "true" ]; then
    if [ "$HANDOVER_MODE" = "window-focus" ]; then
      FRONT_APP="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || true)"
      if printf '%s' "$FRONT_APP" | grep -qiE "$YIELD_REGEX"; then
        EMU_ACTIVE=1
      fi
    else
      if pgrep -if "$YIELD_REGEX" >/dev/null 2>&1; then
        EMU_ACTIVE=1
      fi
    fi
  fi
  if [ "$EMU_ACTIVE" -eq 1 ]; then
    pkill -f "$(basename "$ADAPTER_BIN")" >/dev/null 2>&1 || true
  else
    if ! pgrep -f "$(basename "$ADAPTER_BIN")" >/dev/null 2>&1; then
      "$ADAPTER_BIN" >/dev/null 2>&1 &
    fi
  fi
  sleep 0.4
done
EOF_SUP
  chmod +x "$INSTALL_ROOT/vivimagic-gcbridge-supervisor.sh"

  # Register macOS LaunchAgent under Publisher Vivimagic
  cat <<EOF_AGENT > "$PLIST_PATH"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vivimagic.gcbridgew012</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$INSTALL_ROOT/vivimagic-gcbridge-supervisor.sh</string>
    <string>$YIELD_REGEX</string>
    <string>$AUTO_YIELD</string>
    <string>$HANDOVER_MODE</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
EOF_AGENT

  launchctl unload "$PLIST_PATH" >/dev/null 2>&1 || true
  launchctl load "$PLIST_PATH" >/dev/null 2>&1 || true

  # Ensure Dolphin macOS rumble flags are prepared if Dolphin config directory exists
  DOLPHIN_CFG="$HOME/Library/Application Support/Dolphin/Config/Dolphin.ini"
  if [ -d "$(dirname "$DOLPHIN_CFG")" ]; then
    if [ -f "$DOLPHIN_CFG" ]; then
      grep -q "AdapterRumble0" "$DOLPHIN_CFG" || printf '\nAdapterRumble0 = True\nAdapterRumble1 = True\nAdapterRumble2 = True\nAdapterRumble3 = True\n' >> "$DOLPHIN_CFG"
    fi
  fi

  printf '{"publisher":"Vivimagic","version":"2.0.0","platform":"macOS","handoverMode":"%s"}\n' "$HANDOVER_MODE" > "$INSTALL_ROOT/installed.json"
  notify_mac "Vivimagic GCAdapter v2.0.0 profile & Dolphin auto-handover installed."
  if [ -f "$INSTALL_ROOT/controller-tester.html" ]; then
    open "$INSTALL_ROOT/controller-tester.html" >/dev/null 2>&1 || true
  fi
}

IS_INSTALLED=0
if [ -f "$INSTALL_ROOT/installed.json" ] || [ -f "$PLIST_PATH" ]; then
  IS_INSTALLED=1
fi

if [ "$IS_INSTALLED" -eq 1 ]; then
  CHOICE="$(show_dialog "Vivimagic GameCube Adapter Suite v2.0.0 is installed on this Mac.\n\nPublisher: Vivimagic\nHandover Mode: $HANDOVER_MODE\nLocation: ~/Library/Application Support/Vivimagic/GCBridgeW012\n\nChoose how you want to proceed:" "\"Check Updates\", \"Uninstall\", \"Reinstall Fresh\"" "Reinstall Fresh")"
  if [ "$CHOICE" = "Check Updates" ]; then
    check_updates_mac
  elif [ "$CHOICE" = "Uninstall" ]; then
    do_uninstall
    notify_mac "Vivimagic GameCube Adapter Suite has been completely uninstalled."
  elif [ "$CHOICE" = "Reinstall Fresh" ]; then
    do_uninstall
    do_install
    notify_mac "Reinstalled v2.0.0 with Fresh Settings."
  fi
else
  CHOICE="$(show_dialog "Install Vivimagic GameCube Adapter Suite v2.0.0?\n\nPublisher: Vivimagic\n- Configures 4-port Wii U / NS mode (057E:0337) + Rumble\n- Installs Dolphin / Slippi USB auto-handover ($HANDOVER_MODE)\n- Opens the Live Controller Tester when complete" "\"Cancel\", \"Install Driver\"" "Install Driver")"
  if [ "$CHOICE" = "Install Driver" ]; then
    do_install
  fi
fi
EOF_LAUNCHER

chmod +x "$MACOS_DIR/VivimagicSetup"

# Ad-hoc code sign the .app bundle so Finder & macOS display the Vivimagic icon cleanly
codesign --force --deep --sign - "$APP_DIR" >/dev/null 2>&1 || true
touch "$APP_DIR"

echo ""
echo "[OK] Built native macOS GUI App: $APP_DIR"
if [ "${VIVIMAGIC_CI:-0}" != "1" ]; then
  echo "     Launching Vivimagic GC Suite.app..."
  open "$APP_DIR"
fi
